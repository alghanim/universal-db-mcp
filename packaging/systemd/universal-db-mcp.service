[Unit]
Description=Universal Database MCP Server (read-only, air-gapped)
After=network.target
Documentation=file:/opt/universal-db-mcp/docs/offline-deployment.md

[Service]
Type=simple
User=udbmcp
Group=udbmcp
# Audit trail and metadata cache contain SQL text / schema metadata: create
# private (0600) files regardless of per-file modes in the code.
UMask=0077
Environment=UDBMCP_CONFIG=/etc/universal-db-mcp/config.yaml
# Bearer-token PATH for HTTP mode (the token itself stays in the file created
# 0600 by postinst). An explicit config value would win; this env fallback
# keeps the config shareable with per-harness stdio spawns.
Environment=UDBMCP_HTTP_BEARER_TOKEN_FILE=/etc/universal-db-mcp/http-token
# A daemon under systemd has no client on stdin, so the default config
# transport (stdio) would read EOF and exit 0 immediately. The system service
# is the shared authenticated HTTP daemon; per-harness agents keep spawning
# their own stdio servers.
ExecStart=/opt/universal-db-mcp/venv/bin/python -m universal_db_mcp serve --transport http
Restart=on-failure
RestartSec=5
# Every connection holds a descriptor, and the default soft limit (1024) is
# low for a shared daemon. The server also closes connections that send no
# complete request head within its header deadline.
LimitNOFILE=65536

# Hardening: read-only FS except explicit writable state; no privileges.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# ProtectSystem=strict makes ReadWritePaths= the only writable state, but the
# mount namespace setup fails (exit 226/NAMESPACE) when a listed path does not
# exist — the documented manual unit install creates neither directory.
# StateDirectory=/LogsDirectory= have systemd create /var/lib/universal-db-mcp
# and /var/log/universal-db-mcp (owned by User=/Group=) before the sandbox is
# set up; ReadWritePaths= is kept so the intent stays explicit.
StateDirectory=universal-db-mcp
LogsDirectory=universal-db-mcp
ReadWritePaths=/var/lib/universal-db-mcp /var/log/universal-db-mcp
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
