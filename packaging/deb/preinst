#!/bin/bash
# Debian preinst for universal-db-mcp: trust-prerequisites check ONLY.
#
# ---------------------------------------------------------------------------
# ORDERING — READ BEFORE "FIXING" THIS SCRIPT
#
# dpkg unpacks the package payload AFTER preinst runs. At this moment the
# signed bundle (which this package ships at /usr/share/universal-db-mcp/)
# is NOT on disk yet, so the payload CANNOT be verified here. This is not an
# oversight to be repaired by adding a verifier invocation below — any such
# call would fail (file not found) or, worse, tempt someone into verifying
# against a copy inside the package itself, which proves nothing: a tampered
# package ships a tampered verifier that prints PASSED.
#
# The honest equivalent, per the approved plan:
#   preinst  (this script)  -> check that the trust PREREQUISITES exist:
#                              the admin-installed trusted verifier and the
#                              release public key (distributed out-of-band on
#                              a trusted channel — never shipped in any
#                              package). Exit 1 with bootstrap instructions
#                              if either is absent; dpkg aborts the install.
#   postinst                -> run the ONE trusted installer
#                              (install_offline.sh), which re-verifies the
#                              now-unpacked payload via verify_bundle.py
#                              --pubkey BEFORE anything in it is executed.
# Verify-then-execute is inherited from that installer, not re-implemented.
#
# WHAT VOUCHES FOR THIS SCRIPT ITSELF
# The maintainer scripts (this one, postinst, prerm, postrm) are
# NOT covered by the bundle signature: it covers only the payload, and dpkg
# runs preinst as root from the .deb's control archive before any payload
# exists. The .deb as a whole, maintainer scripts included, is covered by the
# release stick's SHA256SUMS, which release_usb.sh signs with the release key
# (SHA256SUMS.sig). That signature vouches for the .deb only when tools the
# site ALREADY trusts check it with the key the site already holds, BEFORE
# anything from the stick runs: the bootstrap.sh an earlier bootstrap
# installed (sudo bash /usr/local/lib/udbmcp-trust/bootstrap.sh --stick
# <stick>), or, on a site that has none yet, the installed verifier
# (verify_bundle.py --verify-file) or /usr/bin/openssl run by hand. A plain
# `sha256sum -c SHA256SUMS` proves nothing (the list can be regenerated), and
# the stick's own trust-bootstrap-linux/bootstrap.sh is the stick checking
# itself. A .deb that was not checked that way runs whatever preinst it
# carries, and nothing in this file can prevent that.
# ---------------------------------------------------------------------------
set -eu

TRUST_DIR="/usr/local/lib/udbmcp-trust"
VERIFIER="${TRUST_DIR}/verify_bundle.py"
PUBKEY="/etc/universal-db-mcp/keys/release.pub.pem"

# Print a failure diagnostic. Does NOT exit: callers append the matching
# bootstrap instructions and exit 1 themselves (fail closed) so the admin
# sees both the problem and the fix in one dpkg error report.
fail() {
    echo "FAIL: $1" >&2
}

bootstrap_verifier() {
    cat >&2 <<'EOF'
Bootstrap the trusted tools from the same trusted channel that delivered
this package (see docs/offline-deployment.md, 'Trust bootstrap'). ALL of
the files below are required, not just the two scripts: verify_bundle.py
imports profiles.py (the target-profile registry) from its own directory,
and install_offline.sh sources lib/os_packages.sh relative to its own
location. A trust dir missing either file passes this preinst but aborts
later in postinst with a diagnostic about that missing file instead.

    sudo install -d -m 755 /usr/local/lib/udbmcp-trust
    sudo install -m 644 <trusted-channel>/verify_bundle.py /usr/local/lib/udbmcp-trust/
    sudo install -m 644 <trusted-channel>/profiles.py /usr/local/lib/udbmcp-trust/
    sudo install -m 755 <trusted-channel>/install_offline.sh /usr/local/lib/udbmcp-trust/
    sudo install -d -m 755 /usr/local/lib/udbmcp-trust/lib
    sudo install -m 644 <trusted-channel>/lib/os_packages.sh /usr/local/lib/udbmcp-trust/lib/
EOF
}

bootstrap_pubkey() {
    cat >&2 <<'EOF'
Install the release public key (distributed out-of-band by the release
administrator; it is deliberately NOT shipped inside any package):

    sudo install -d -m 755 /etc/universal-db-mcp /etc/universal-db-mcp/keys
    sudo install -m 644 <trusted-path>/udbmcp-release.pub.pem /etc/universal-db-mcp/keys/release.pub.pem
EOF
}

# --- prerequisite 1: the trusted verifier -----------------------------------
# Installed by the admin with `install -m 644`, so it is executed via
# python3, not directly: check readability, never the exec bit.
if [ ! -r "$VERIFIER" ]; then
    fail "trusted verifier not found (or not readable) at $VERIFIER.

The package refuses to install without it: nothing in this package may run
payload that has not passed verification by an admin-installed trusted
verifier obtained outside the package/bundle supply chain."
    bootstrap_verifier
    echo "universal-db-mcp: package installation ABORTED (fail closed)." >&2
    exit 1
fi
# A zero-length verifier is not a verifier: python3 on an empty script exits
# 0 without ever running argparse, so a truncated trusted-channel copy would
# 'pass' readability and then verify nothing (mirrors the -s guard in
# packaging/deb/postinst).
if [ ! -s "$VERIFIER" ]; then
    fail "trusted verifier at $VERIFIER exists but is EMPTY — python3 exits 0 on an empty script, so a truncated trusted-channel copy would 'verify' vacuously and must abort the install exactly like a missing one."
    bootstrap_verifier
    echo "universal-db-mcp: package installation ABORTED (fail closed)." >&2
    exit 1
fi

# A zero-length verifier is not a verifier: python3 on an empty script exits 0
# without ever running argparse, so a truncated trusted-channel copy would
# 'pass' the postinst verification vacuously and the unverified payload would
# be installed and the service enabled — the exact vacuous-pass attack the
# .pkg preinstall ([ ! -s ]) and the msi custom action ('bundle verification
# PASSED' proof) guard. Treat an empty copy exactly like a missing one.
if [ ! -s "$VERIFIER" ]; then
    fail "trusted verifier at $VERIFIER exists but is EMPTY.

python3 exits 0 on an empty script without verifying anything, so a
truncated trusted-channel copy would defeat the verify-then-execute
boundary. The package refuses to install against it."
    bootstrap_verifier
    echo "universal-db-mcp: package installation ABORTED (fail closed)." >&2
    exit 1
fi

# --- prerequisite 2: the release public key ---------------------------------
# Never shipped inside this package (or any artifact of the release): the
# admin distributes it out-of-band so that verifying with it actually means
# something. Fail closed if it is not in place.
if [ ! -r "$PUBKEY" ]; then
    fail "release public key not found (or not readable) at $PUBKEY.

The package refuses to install without it: post-install verification of the
signed bundle requires the admin-held public key, and an unsigned/unverified
bundle must never be installed."
    bootstrap_pubkey
    echo "universal-db-mcp: package installation ABORTED (fail closed)." >&2
    exit 1
fi

# --- prerequisite 3: the trusted installer is not an outdated copy ---------
# The package runs the ADMIN-installed installer, never its own copy. A copy
# from before 2026-09-15 runs pip without --force-reinstall: the app wheel's
# version does not change between releases, so pip keeps the previous code
# while dpkg, the manifest and the status file all report a successful
# upgrade (seen live at a site). Refuse such a copy before the payload is
# unpacked; the fix is to re-run the trust bootstrap from the release stick.
INSTALLER="${TRUST_DIR}/install_offline.sh"
if [ -s "$INSTALLER" ] && grep -q "PIP_FIND_LINKS" "$INSTALLER" && ! grep -q -- "--force-reinstall" "$INSTALLER"; then
    fail "the trusted installer at $INSTALLER is an OUTDATED copy (it runs pip without --force-reinstall).
An upgrade through it would keep the previous release's code in the venv while
reporting success. Refresh the trusted tools from the release stick first:

    sudo bash <stick>/trust-bootstrap-linux/bootstrap.sh

then re-run this install."
    echo "universal-db-mcp: package installation ABORTED (fail closed)." >&2
    exit 1
fi
# The installer also carries a format marker ('# udbmcp-installer-format: N');
# any pip-running copy without the current number is refused the same way
# (build-then-switch venvs, --copies interpreters and rollback all depend on it).
INSTALLER_FORMAT=4
if [ -s "$INSTALLER" ] && grep -q "PIP_FIND_LINKS" "$INSTALLER" \
   && ! grep -q "^# udbmcp-installer-format: ${INSTALLER_FORMAT}\$" "$INSTALLER"; then
    fail "the trusted installer at $INSTALLER is an OUTDATED copy (no 'udbmcp-installer-format: ${INSTALLER_FORMAT}' marker).
This package relies on installer behaviour that copy predates (it builds the new
venv beside the running one and switches, so a failed upgrade never leaves a
half-replaced install). Refresh the trusted tools from the release stick first:

    sudo bash <stick>/trust-bootstrap-linux/bootstrap.sh

then re-run this install."
    echo "universal-db-mcp: package installation ABORTED (fail closed)." >&2
    exit 1
fi

# --- prerequisite 4: the trusted verifier can refuse a downgrade -----------
# postinst verifies with --installed-manifest (anti-rollback). A verifier
# that parses options (argparse's add_argument) but has none predates that
# check: refused here, before the old prerm's stop is followed by an unpack
# this package could only leave half-configured. postinst keeps its own check
# (and the one its argparse gives away) for a configure run without this
# preinst. Nothing here runs the verifier.
if grep -q -- 'add_argument(' "$VERIFIER" && ! grep -q -- '"--installed-manifest"' "$VERIFIER"; then
    fail "the trusted verifier at $VERIFIER is an OUTDATED copy (no --installed-manifest option): it cannot refuse a downgrade to an older release. Refresh the trusted tools from the release stick first:

    sudo bash <stick>/trust-bootstrap-linux/bootstrap.sh

then re-run this install."
    echo "universal-db-mcp: package installation ABORTED (fail closed)." >&2
    exit 1
fi

# --- prerequisite 5: not an older release than the installed one ----------
# postinst's verifier refuses an OLDER release than the installed one, but
# only after dpkg unpacked it over the newer payload, leaving the package
# half-configured. The payload's release_seq and source revision, written
# here by scripts/package/build_deb.sh from the signed manifest, are known
# now, so an older package (or another release with the same release_seq)
# stops before dpkg unpacks anything. Empty in the repository copy. The
# verifier in postinst stays the authority for everything this cannot order
# (releases that predate release_seq, an unreadable installed manifest).
PAYLOAD_RELEASE_SEQ=""
PAYLOAD_SOURCE_REV=""
INSTALLED_MANIFEST="/opt/universal-db-mcp/manifest.json"
if [ -n "$PAYLOAD_RELEASE_SEQ" ] && [ -f "$INSTALLED_MANIFEST" ] && [ "${UDBMCP_ALLOW_DOWNGRADE:-}" != "1" ] \
   && command -v python3 >/dev/null 2>&1; then
    installed="$(python3 -I -S -c 'import json, sys
m = json.load(open(sys.argv[1], encoding="utf-8"))
seq, rev = m.get("release_seq"), m.get("source_rev")
print(seq if type(seq) is int and seq >= 0 else "")
print(rev.strip() if isinstance(rev, str) and rev.strip().lower() not in ("", "unknown") else "")' "$INSTALLED_MANIFEST" 2>/dev/null)" || installed=""
    installed_seq="$(printf '%s\n' "$installed" | sed -n 1p)"
    installed_rev="$(printf '%s\n' "$installed" | sed -n 2p)"
    refused=""
    if [ -n "$installed_seq" ] && [ "$PAYLOAD_RELEASE_SEQ" -lt "$installed_seq" ]; then
        refused="this package is release_seq $PAYLOAD_RELEASE_SEQ, OLDER than the installed release_seq $installed_seq"
    elif [ -n "$installed_seq" ] && [ "$PAYLOAD_RELEASE_SEQ" -eq "$installed_seq" ] && [ -n "$PAYLOAD_SOURCE_REV" ] \
         && [ -n "$installed_rev" ] && [ "$PAYLOAD_SOURCE_REV" != "$installed_rev" ]; then
        refused="this package (source_rev $PAYLOAD_SOURCE_REV) is another release with the installed release's release_seq $installed_seq (source_rev $installed_rev), which may be the older one"
    fi
    if [ -n "$refused" ]; then
        fail "rollback refused: $refused ($INSTALLED_MANIFEST); nothing was unpacked.
If the downgrade is intended, run:

    sudo UDBMCP_ALLOW_DOWNGRADE=1 dpkg -i <this .deb>"
        echo "universal-db-mcp: package installation ABORTED (fail closed)." >&2
        exit 1
    fi
fi

echo "universal-db-mcp preinst: trust prerequisites present."
echo "  verifier: $VERIFIER"
echo "  pubkey:   $PUBKEY"
echo "Payload verification happens in postinst via the trusted installer"
echo "(dpkg unpacks the payload only after this script exits)."

exit 0
