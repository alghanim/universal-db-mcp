#!/bin/bash
# Debian postrm for universal-db-mcp: delete installer-generated payload
# artifacts on purge; keep the conffile on remove (standard dpkg semantics).
#
# ---------------------------------------------------------------------------
# WHAT dpkg ALREADY DOES vs. WHAT THIS SCRIPT DOES
#
# dpkg deletes every file this package OWNS on both `remove` and `purge`
# (package payload: the signed bundle copy, the trusted-tools copy, the
# deb-shipped unit COPY under /usr/share/universal-db-mcp/systemd/). What dpkg
# does NOT track are files GENERATED after unpack by postinst:
#
#   /opt/universal-db-mcp/venv           <- built from the wheelhouse by the
#                                           trusted installer (install_offline.sh)
#   /opt/universal-db-mcp/manifest.json  <- the verified bundle's manifest,
#                                           published next to the venv so
#                                           `doctor` can report the profile
#   /etc/systemd/system/universal-db-mcp.service
#                                        <- postinst installs the unit with
#                                           `install` (admin-controlled path,
#                                           deliberately NOT a dpkg-owned file)
#   /etc/systemd/system/universal-db-mcp.service.d/
#                                        <- postinst's deferred-install guard
#                                           drop-in lives here
#   /var/lib/universal-db-mcp-package/   <- postinst's record of the deployed
#                                           unit's hash (upgrade decisions),
#                                           in a directory root alone can write
#   /var/lib/universal-db-mcp/.shipped-unit.sha256
#                                        <- where releases before that kept it
#
# That is the entire job of this script: on `purge`, remove the venv tree,
# the published manifest, the deployed unit with its drop-in directory and
# the unit hash record (rm -rf / rm -f, deliberate and scoped — every target
# is a quoted path literal defined at the top of this script), then
# daemon-reload so systemd forgets the unit. Without the manifest removal the
# guarded parent `rmdir` below would always fail and a stale manifest.json
# would survive `dpkg -P`; without the unit removal `dpkg -P` left a unit
# behind whose ExecStart pointed at the venv this script had just deleted.
#
# The installed bundle tree (/usr/share/universal-db-mcp/bundle) needs NO
# cleanup here: install_offline.sh never writes inside it — it stages into a
# private `mktemp -d` directory under /var/tmp that an EXIT trap removes — and
# dpkg has already deleted the dpkg-owned bundle tree by the time this script
# runs with `purge`. The parent `rmdir`s below are therefore only defensive.
#
# On `remove`, the venv (and the manifest) are kept so that a subsequent
# reinstall is fast and so that a rollback to an older package version keeps a
# working installation; they are destroyed by the next `purge`.
#
# CONFIG (/etc/universal-db-mcp/config.yaml): a dpkg conffile (registered in
# DEBIAN/conffiles and staged by build_deb.sh), so dpkg itself keeps it on
# `remove` and deletes it on `purge`. postinst additionally seeds it
# only-if-absent from the verified bundle's config-templates/ copy as a
# fallback for a conffile an admin deleted before an upgrade. On `purge` the
# config is deleted here as belt and braces: after dpkg's own conffile
# deletion the `rm -f` is a harmless no-op, but it guarantees the
# postinst-seeded fallback copy can never survive a purge (the /keys
# subdirectory with the admin-held release public key is NEVER touched); on
# `remove` it is kept, mirroring standard conffile retention semantics.
#
# AUDIT / STATE DIRECTORIES (/var/lib/universal-db-mcp, /var/log/universal-db-mcp):
# deliberately NOT removed here, not even on purge: they hold the audit
# trail, which must outlive the package that produced it. An admin who wants
# them gone deletes them explicitly. Only the unit hash record FILE inside the
# state directory is removed (it describes the unit being purged).
#
# TOLERANCE: container installs have no systemd as PID 1 (mirrors prerm), so
# the daemon-reload is guarded and never fails the purge.
# ---------------------------------------------------------------------------
set -eu

VENV_DIR="/opt/universal-db-mcp/venv"
MANIFEST_FILE="/opt/universal-db-mcp/manifest.json"
CONFIG_FILE="/etc/universal-db-mcp/config.yaml"
UNIT_FILE="/etc/systemd/system/universal-db-mcp.service"
UNIT_DROPIN_DIR="/etc/systemd/system/universal-db-mcp.service.d"
UNIT_RECORD_DIR="/var/lib/universal-db-mcp-package"
SHIPPED_UNIT_RECORD="/var/lib/universal-db-mcp/.shipped-unit.sha256"

# --- abort-upgrade: keep the installed release from re-installing itself ----
# dpkg undoes an upgrade (this package's preinst refused, or the unpack failed
# after it passed: a file conflict, a full disk) by running this script with
# abort-upgrade and then the INSTALLED release's postinst with abort-upgrade.
# dpkg runs this script first on every path that undoes an upgrade. A
# postinst from before this release ignores its argument and configures again:
# for a bundle with OS packages it spawns a deferred install worker that
# re-installs the installed release (replacing venv.previous, the rollback
# point) and can still be running when the admin retries, so that dpkg
# records the new package while the worker publishes the older code. Every
# such postinst spawns no worker while $DEFERRED_LOCK is held. So this script
# takes that lock and hands it to a small detached process (its fd 9 is the
# one taken here) that holds it until this dpkg run has ended, then starts
# the service again when it is enabled and not running (what this release's
# own postinst does for abort-upgrade). A lock already held means an install
# worker is running: nothing is spawned then. Outside dpkg (no
# DPKG_MAINTSCRIPT_NAME), or without flock/setsid, nothing is done. Never
# fails: a failing postrm abort-upgrade would leave the package half-installed.
DEFERRED_LOCK=/run/udbmcp-deferred-install.lock
UNWIND_HOLDER='i=0
while kill -0 "$1" 2>/dev/null && [ "$i" -lt 7200 ]; do sleep 0.5; i=$((i + 1)); done
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ] \
   && systemctl is-enabled --quiet universal-db-mcp 2>/dev/null \
   && ! systemctl is-active --quiet universal-db-mcp 2>/dev/null; then
  systemctl start --no-block universal-db-mcp 2>/dev/null || true
fi'
hold_the_unwind() {
    [ "${DPKG_MAINTSCRIPT_NAME:-}" = postrm ] || return 0
    command -v flock >/dev/null 2>&1 && command -v setsid >/dev/null 2>&1 || return 0
    { exec 9>>"$DEFERRED_LOCK"; } 2>/dev/null || return 0
    if flock -n 9; then
        if setsid --fork /bin/bash -c "$UNWIND_HOLDER" udbmcp-unwind-holder "$PPID" </dev/null >/dev/null 2>&1; then
            echo "universal-db-mcp postrm: the installed release's postinst is kept from starting an install worker while dpkg undoes this upgrade." >&2
        fi
    fi
    exec 9>&-
}

warn() {
    echo "WARN: $1" >&2
}

systemd_available() {
    # systemctl binary present AND systemd actually running as init (see prerm).
    command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]
}

case "${1:-}" in
    purge)
        if [ -e "$VENV_DIR" ]; then
            rm -rf "$VENV_DIR"
            echo "universal-db-mcp postrm: purged $VENV_DIR."
        fi
        if [ -f "$MANIFEST_FILE" ]; then
            rm -f "$MANIFEST_FILE"
            echo "universal-db-mcp postrm: purged $MANIFEST_FILE."
        fi
        if [ -f "$CONFIG_FILE" ]; then
            rm -f "$CONFIG_FILE"
            echo "universal-db-mcp postrm: purged $CONFIG_FILE."
        fi
        # The deployed unit, its drop-in directory and the hash record are
        # postinst-generated (installed with `install`, not dpkg-owned):
        # prerm already stopped and disabled the service.
        unit_removed=0
        if [ -f "$UNIT_FILE" ]; then
            rm -f "$UNIT_FILE"
            echo "universal-db-mcp postrm: purged $UNIT_FILE."
            unit_removed=1
        fi
        if [ -d "$UNIT_DROPIN_DIR" ]; then
            rm -rf "$UNIT_DROPIN_DIR"
            echo "universal-db-mcp postrm: purged $UNIT_DROPIN_DIR."
            unit_removed=1
        fi
        if [ -d "$UNIT_RECORD_DIR" ]; then
            rm -rf "$UNIT_RECORD_DIR"
            echo "universal-db-mcp postrm: purged $UNIT_RECORD_DIR."
        fi
        if [ -f "$SHIPPED_UNIT_RECORD" ]; then
            rm -f "$SHIPPED_UNIT_RECORD"
            echo "universal-db-mcp postrm: purged $SHIPPED_UNIT_RECORD."
        fi
        if [ "$unit_removed" -eq 1 ]; then
            if systemd_available; then
                systemctl daemon-reload 2>/dev/null \
                    || warn "systemctl daemon-reload failed after removing $UNIT_FILE — continuing."
            else
                warn "systemd not active (container or non-systemd host): skipping daemon-reload."
            fi
        fi
        # Remove the parent directories only if now empty (never with -r:
        # anything left beside them — e.g. unrelated files under /opt or
        # /usr/share — must survive). Failures are expected and fine.
        # /etc/universal-db-mcp is rmdir'd the same guarded way: it holds the
        # admin's keys/ directory (the out-of-band release public key), which
        # must survive a purge, so the rmdir only succeeds if it is empty.
        rmdir --ignore-fail-on-non-empty /opt/universal-db-mcp 2>/dev/null || true
        rmdir --ignore-fail-on-non-empty /usr/share/universal-db-mcp 2>/dev/null || true
        rmdir --ignore-fail-on-non-empty /etc/universal-db-mcp 2>/dev/null || true
        ;;
    remove)
        echo "universal-db-mcp postrm: remove — seeded config $CONFIG_FILE," \
             "installer-generated $VENV_DIR and $MANIFEST_FILE and the deployed" \
             "unit $UNIT_FILE are retained (purge deletes them)."
        ;;
    abort-upgrade)
        # No cleanup: the installed release's files are back in place. See
        # hold_the_unwind above.
        hold_the_unwind || true
        ;;
    upgrade|failed-upgrade|abort-install)
        # No cleanup: the installation continues or rolls back as-is.
        ;;
    "")
        # dpkg always passes an action; refuse to act without one (fail closed).
        echo "universal-db-mcp postrm: no dpkg action argument; refusing to act." >&2
        exit 1
        ;;
    *)
        warn "unexpected postrm action '$1'; taking no cleanup action."
        ;;
esac

exit 0
