#!/bin/bash
# macOS .pkg postinstall: runs as root AFTER the installer has unpacked the
# payload to /usr/local/universal-db-mcp/bundle.
#
# Trust model (invariants that must never break):
#   1. NO payload code executes before the trusted-channel verifier has passed
#      against the unpacked bundle with the ADMIN-provided release pubkey
#      (step 1 below; the smoke check in step 4 is the first execution).
#   2. The release pubkey is NEVER shipped inside this package. It is
#      distributed out-of-band and read from /etc/universal-db-mcp/keys/ —
#      preinstall validated its presence; we still fail closed here if absent.
#   3. pip runs --no-index --require-hashes against the bundle wheelhouse only,
#      with the inherited (hostile) pip environment neutralized.
#   4. Every verification failure exits nonzero so the install aborts.
#   5. A payload that is an OLDER release than the installed one is refused
#      unless root asked for the downgrade with a one-shot flag file (step 1).
#
# This script is a pkg-embedded copy of the trusted-channel installer logic
# (scripts/install_offline.sh); the verifier it invokes is NOT — it must come
# from the trusted channel installed at /usr/local/lib/udbmcp-trust/, never
# from the bundle it verifies (a tampered bundle would ship a verifier that
# prints PASSED).
#
# Non-relocatable: every path below is absolute and load-bearing. The
# installer-provided arguments (target volume, boot volume, admin user) are
# deliberately ignored.
set -euo pipefail

PREFIX="/usr/local/universal-db-mcp"
BUNDLE="$PREFIX/bundle"
VENV="$PREFIX/venv"
PLIST="/Library/LaunchDaemons/com.udbmcp.server.plist"
LABEL="com.udbmcp.server"
CONFIG_DIR="/etc/universal-db-mcp"
CONFIG="$CONFIG_DIR/config.yaml"
STATE_DIR="/var/lib/universal-db-mcp"
LOG_DIR="/var/log/universal-db-mcp"
# launchd's StandardOutPath and StandardErrorPath for the daemon (step 6c).
LAUNCHD_LOG_DIR="/Library/Logs/universal-db-mcp"
SERVICE_USER="_udbmcp"
SERVICE_GROUP="_udbmcp"

# Trust prerequisites. Defaults are the documented trusted-channel locations;
# the overrides exist for parity with install_offline.sh (and our gate
# scripts), not to relocate trust onto the bundle.
TRUST_DIR="${UDBMCP_TRUST_DIR:-/usr/local/lib/udbmcp-trust}"
VERIFIER="${UDBMCP_VERIFIER:-$TRUST_DIR/verify_bundle.py}"
PUBKEY="${UDBMCP_RELEASE_PUBKEY:-$CONFIG_DIR/keys/release.pub.pem}"

# An intended downgrade is asked for with a root-owned flag file (step 1): the
# Installer does not pass the caller's environment. It authorises THIS install
# attempt only, so it is removed on every exit: an attempt that fails early
# never leaves it armed for a later, unrelated older package.
DOWNGRADE_FLAG="$CONFIG_DIR/allow-downgrade"
trap 'rm -f "$DOWNGRADE_FLAG" 2>/dev/null || true' EXIT

# The payload's release_seq, written here by scripts/package/build_pkg.sh from
# the signed manifest. Empty in the repository copy, and for a bundle without
# one (the verifier orders such a release in postinstall).
PAYLOAD_RELEASE_SEQ=""

# The OS tools only (dscl, install, launchctl, find): nothing executed as root
# here may resolve from a user-writable prefix such as /opt/homebrew/bin. The
# interpreter is referenced by absolute path, never a PATH search (see step 1).
PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

fail() {
  echo "FAIL: $*" >&2
  echo "      The installation has been aborted; nothing was started." >&2
  exit 1
}

# --- step 1: re-verify the unpacked payload BEFORE anything executes it ------
# The pkg payload was verified on the build host and again by preinstall
# (prerequisites only); this is the gate that stands between unpacking and the
# first execution of bundle code. pkgbuild unpacks as root into a root-owned
# path, so no operator-writable window exists between this verification and
# the use below (the verify-then-use staging dance in install_offline.sh is
# not needed here — but failing closed on any verifier complaint is).
echo "==> postinstall: verifying unpacked payload with the trusted verifier"

# Fail closed on missing prerequisites (preinstall already checked these; a
# missing pubkey here means the admin skipped trust bootstrap — never proceed,
# and never fall back to a key shipped inside the bundle or the package).
[ -f "$BUNDLE/manifest.json" ] || fail "bundle payload missing at $BUNDLE"
[ -f "$PUBKEY" ] || fail "release pubkey not found at $PUBKEY; install it from the trusted channel (out-of-band) and re-run the installer"
[ -f "$VERIFIER" ] || fail "trusted verifier not found at $VERIFIER; install the trusted tools (see docs/offline-deployment.md, 'Trust bootstrap')"

# The verifier must not come from the bundle it verifies (see header comment).
# The pattern also refuses the bundle root itself ("$bundle_real" alone): a
# verifier/pubkey placed DIRECTLY at the payload root makes dirname resolve to
# exactly the bundle path, which "$bundle_real"/* alone would let through.
bundle_real="$(cd "$BUNDLE" && pwd -P)"
case "$(cd "$(dirname "$VERIFIER")" && pwd -P)" in
  "$bundle_real"|"$bundle_real"/*)
    fail "refusing to verify with a verifier inside the bundle; install the trusted tools at $TRUST_DIR" ;;
esac
case "$(cd "$(dirname "$PUBKEY")" && pwd -P)" in
  "$bundle_real"|"$bundle_real"/*)
    fail "refusing to verify with a pubkey shipped inside the bundle; install it at $PUBKEY from the trusted channel" ;;
esac

# The verifier executes as root, so it runs under the interpreter preinstall
# validated, selected by the same code: never a PATH search, never before its
# installation is proven root's alone. The same interpreter builds the venv in
# step 3.
# >>> root-owned CPython 3.12: this block is identical in preinstall and postinstall
# Root runs the selected interpreter BEFORE the payload is verified: the
# trusted verifier runs under it, the venv is copied from it, and its stdlib
# loads into every root-side python here. Whoever can write to that
# installation therefore runs code as root (a .pth file dropped into an
# admin-writable Homebrew site-packages turned a tampered bundle into
# "bundle verification PASSED"). So no candidate is executed until its whole
# installation, resolved through symlinks, and every directory above it are
# owned by root and writable by root only (group write only for wheel, gid 0,
# and no ACL), and none of its symlinks leads out of it. That proves who owns
# each file, not what a .pth file in site-packages names (a directory, or an
# import line, outside the installation), so every root-side run of the
# interpreter is also -I -S: site.py never reads site-packages at all.
# The candidates are FIXED all-users paths, never a PATH search, which could
# find a per-user interpreter the _udbmcp service account cannot see:
#   - the python.org 3.12 installer's framework, and /usr/local/bin/python3,
#     its symlink. That installer leaves the framework writable by the admin
#     group, so preparing the host includes the fix printed below;
#   - Homebrew (Apple Silicon /opt/homebrew, Intel /usr/local), accepted only
#     when the whole Homebrew prefix is root's: its python imports
#     <prefix>/lib/python3.12/site-packages and its _ssl/_hashlib load the
#     openssl@3 keg through <prefix>/opt.
FRAMEWORK_PY="/Library/Frameworks/Python.framework/Versions/3.12/bin/python3"
USR_LOCAL_PY="/usr/local/bin/python3"
BREW_ARM_PY="/opt/homebrew/bin/python3.12"
BREW_INTEL_PY="/usr/local/bin/python3.12"
FIND="/usr/bin/find"

# Physical path of $1 with every symlink resolved (macOS before 13 ships no
# realpath(1), and its readlink(1) has no -f).
resolve_path() {
  local path="$1" dir link hops=0
  while :; do
    dir="$(cd "$(dirname "$path")" 2>/dev/null && pwd -P)" || return 1
    path="${dir%/}/$(basename "$path")"
    [ -L "$path" ] || break
    link="$(readlink "$path")" || return 1
    case "$link" in
      /*) path="$link" ;;
      *) path="${dir%/}/$link" ;;
    esac
    hops=$((hops + 1))
    [ "$hops" -lt 40 ] || return 1
  done
  printf '%s\n' "$path"
}

# The first entry of the tree $1 (itself included) that is not owned by root,
# that another account can write, or that carries an ACL (an "everyone allow
# write" entry survives chmod go-w). Symlinks are skipped here: the directory
# that holds them is checked, and escaping_symlink checks where they lead. A
# tree find cannot read reports itself.
untrusted_in_tree() {
  local hit
  hit="$("$FIND" "$1" ! -type l \( ! -user 0 -o -perm -0002 -o \( -perm -0020 ! -group 0 \) -o -acl \) \
    -print -quit 2>/dev/null)" || hit="${hit:-$1}"
  printf '%s' "$hit"
}

# $1 when that one directory is not root's alone. A sticky directory such as
# /tmp may be writable: nobody else can rename what root owns inside it. An
# ACL is refused either way.
untrusted_dir() {
  local hit
  hit="$("$FIND" "$1" -maxdepth 0 \( ! -user 0 -o -acl -o \( ! -perm -1000 \( -perm -0002 -o \
    \( -perm -0020 ! -group 0 \) \) \) \) -print 2>/dev/null)" || hit="$1"
  printf '%s' "$hit"
}

NL=$'\n'

# Prints "<why>\n<fix>" for the first symlink in the tree $1 that does not
# stay inside the trees $2...: chown -R and chmod -R do not follow symlinks
# and the checks above skip them, so a stdlib module or extension linked out
# of the installation (to a file another account can write, or to one it
# creates later) would still run as root, -I -S or not. A link passes when it
# resolves to something that exists and its text, walked from the link's
# directory, stays on root's ground: '..' only before the first name (a '..'
# after a name climbs out of wherever that name leads) and the end inside the
# trees. A link that ends on another link is safe because that one is
# checked too. Link texts are read in batches, one per line, and walked with
# shell builtins (a Homebrew prefix holds tens of thousands of links), so a
# name or link text with a line break is refused before any is read.
escaping_symlink() {
  local tree="$1" link rest part path named inside t i n=0 at=0
  local -a links=() targets=()
  shift
  link="$("$FIND" "$tree" \( -name "*$NL*" -o -lname "*$NL*" \) -print -quit 2>/dev/null)" || link="$tree"
  if [ -n "$link" ]; then
    printf '%s\n%s' "$tree holds a name or a symlink text with a line break, or could not be read" "reinstall it"
    return
  fi
  while IFS= read -r link; do links[n]="$link"; n=$((n + 1)); done < <("$FIND" "$tree" -type l -print 2>/dev/null)
  while [ "$at" -lt "$n" ]; do
    while IFS= read -r t; do targets[${#targets[@]}]="$t"; done < <(readlink "${links[@]:at:1000}")
    at=$((at + 1000))
  done
  if [ "${#targets[@]}" -ne "$n" ]; then
    printf '%s\n%s' "the symlinks in $tree could not be read" "reinstall it"
    return
  fi
  for ((i = 0; i < n; i++)); do
    link="${links[i]}"
    rest="${targets[i]}"
    case "$rest" in /*) path="" ;; *) path="${link%/*}" ;; esac
    named=0
    inside=0
    while [ -n "$rest" ]; do
      part="${rest%%/*}"
      if [ "$part" = "$rest" ]; then rest=""; else rest="${rest#*/}"; fi
      case "$part" in
        "" | .) ;;
        ..) if [ "$named" -ne 0 ]; then named=2; break; fi; path="${path%/*}" ;;
        *) named=1; path="$path/$part" ;;
      esac
    done
    if [ "$named" -ne 2 ]; then
      for t in "$@"; do
        case "${path:-/}" in "$t" | "$t"/*) inside=1 ;; esac
      done
    fi
    if [ "$inside" -eq 0 ] || [ ! -e "$link" ]; then
      printf '%s\n%s' "$link is a symlink to ${targets[i]}, which leads out of $* or to nothing: chown -R and chmod -R do not follow it, and root would load whatever it leads to" \
        "sudo rm $link"
      return
    fi
  done
}

# Returns 0 when each tree in $@, every directory above it and wherever its
# symlinks lead are root's alone. Otherwise returns 1 with UNTRUSTED_WHY
# saying which path is the problem and UNTRUSTED_FIX the command that
# repairs it. The check only stats files and reads links.
root_only_trees() {
  local tree dir hit
  for tree in "$@"; do
    dir="$tree"
    while [ "$dir" != "/" ]; do
      dir="$(dirname "$dir")"
      hit="$(untrusted_dir "$dir")"
      if [ -n "$hit" ]; then
        UNTRUSTED_WHY="$hit is not owned by root, or another account can write to it (write bits or an ACL)"
        UNTRUSTED_FIX="sudo chown root:wheel $hit; sudo chmod go-w $hit; sudo chmod -N $hit"
        return 1
      fi
    done
    hit="$(untrusted_in_tree "$tree")"
    if [ -n "$hit" ]; then
      UNTRUSTED_WHY="$hit is not owned by root, or another account can write to it (write bits or an ACL)"
      UNTRUSTED_FIX="sudo chown -R root:wheel $tree; sudo chmod -R go-w $tree; sudo chmod -R -N $tree"
      return 1
    fi
    hit="$(escaping_symlink "$tree" "$@")"
    if [ -n "$hit" ]; then
      UNTRUSTED_WHY="${hit%%"$NL"*}"
      UNTRUSTED_FIX="${hit#*"$NL"}"
      return 1
    fi
  done
}

# Returns 0 with PY_REAL set to the resolved binary when the installation of
# candidate $1 is root's alone. Otherwise returns 1 with UNTRUSTED_WHY and
# UNTRUSTED_FIX set (see root_only_trees). The candidate is never executed
# here.
root_only_python() {
  local bin prefix root site cfg
  PY_REAL=""
  UNTRUSTED_WHY="$1 does not resolve to a file"
  UNTRUSTED_FIX="reinstall CPython 3.12"
  bin="$(resolve_path "$1")" || return 1
  prefix="$(dirname "$(dirname "$bin")")"
  # A virtual environment loads its stdlib from the "home" its pyvenv.cfg
  # names, which is not what the checks below cover.
  for cfg in "$(dirname "$bin")/pyvenv.cfg" "$prefix/pyvenv.cfg"; do
    if [ -e "$cfg" ]; then
      UNTRUSTED_WHY="$cfg makes it a virtual environment, whose standard library lives elsewhere"
      UNTRUSTED_FIX="point the installer at CPython 3.12 itself, not at a virtual environment"
      return 1
    fi
  done
  case "$bin" in
    */Cellar/*) root="${bin%%/Cellar/*}" ;;
    */Python.framework/*) root="${bin%%/Python.framework/*}/Python.framework" ;;
    *) root="$prefix" ;;
  esac
  set -- "$root"
  if [ -e "$prefix/lib/python3.12/site-packages" ]; then
    site="$(resolve_path "$prefix/lib/python3.12/site-packages")" || return 1
    case "$site" in
      "$root" | "$root"/*) ;;
      *) set -- "$root" "$site" ;;
    esac
  fi
  root_only_trees "$@" || return 1
  PY_REAL="$bin"
}

# Sets PY to the resolved binary of the first candidate that is root's alone
# and is CPython 3.12. A refused candidate is never run; the first one refused
# is kept in REFUSED_PY/REFUSED_WHY/REFUSED_FIX.
select_root_python() {
  local candidate
  PY=""
  REFUSED_PY=""
  REFUSED_WHY=""
  REFUSED_FIX=""
  for candidate in "$FRAMEWORK_PY" "$USR_LOCAL_PY" "$BREW_ARM_PY" "$BREW_INTEL_PY"; do
    [ -x "$candidate" ] || continue
    if ! root_only_python "$candidate"; then
      if [ -z "$REFUSED_PY" ]; then
        REFUSED_PY="$candidate"
        REFUSED_WHY="$UNTRUSTED_WHY"
        REFUSED_FIX="$UNTRUSTED_FIX"
      fi
      continue
    fi
    if "$PY_REAL" -I -S -c 'import sys; sys.exit(0 if sys.version_info[:2] == (3, 12) else 1)' 2>/dev/null; then
      PY="$PY_REAL"
      return 0
    fi
  done
  return 1
}

report_refused_python() {
  echo "FAIL: refusing to run $REFUSED_PY as root: $REFUSED_WHY." >&2
  echo "      The installer runs this interpreter as root before the payload is" >&2
  echo "      verified, so its whole installation and every directory above it must" >&2
  echo "      be owned by root and writable by root only, and none of its symlinks" >&2
  echo "      may lead out of it. Fix it with:" >&2
  echo "" >&2
  echo "        $REFUSED_FIX" >&2
  echo "" >&2
  echo "      The supported interpreter is the python.org 3.12 installer" >&2
  echo "      (https://www.python.org/downloads/macos/); it leaves" >&2
  echo "      /Library/Frameworks/Python.framework writable by the admin group, so run:" >&2
  echo "        sudo chown -R root:wheel /Library/Frameworks/Python.framework; sudo chmod -R go-w /Library/Frameworks/Python.framework; sudo chmod -R -N /Library/Frameworks/Python.framework" >&2
  echo "      after installing it. Then re-run this installer." >&2
}
# <<< root-owned CPython 3.12

# >>> one-shot downgrade flag: identical in preinstall and postinstall
# The Installer drops the caller's environment, so an intended downgrade is
# asked for with a flag file naming the release_seq of the package it
# authorises: a flag left by an earlier attempt cannot authorise another
# package. It counts only when root alone wrote it: a regular file with one
# link, owned by root, in a directory (resolved) that root alone can write
# (a sticky world-writable one is no exemption here: anyone can hard-link a
# root-owned file under the flag's name there), below directories that are
# root's alone.
if [ -n "$PAYLOAD_RELEASE_SEQ" ]; then
  ALLOW_DOWNGRADE_CMD="echo $PAYLOAD_RELEASE_SEQ | sudo tee $DOWNGRADE_FLAG"
else
  ALLOW_DOWNGRADE_CMD="sudo touch $DOWNGRADE_FLAG"
fi
downgrade_authorised() {
  local dir flag
  dir="$(cd "$(dirname "$DOWNGRADE_FLAG")" 2>/dev/null && pwd -P)" || return 1
  flag="$dir/$(basename "$DOWNGRADE_FLAG")"
  [ -n "$("$FIND" "$flag" -maxdepth 0 -type f -links 1 -user 0 -print 2>/dev/null)" ] || return 1
  [ -n "$("$FIND" "$dir" -maxdepth 0 -user 0 ! -perm -0002 ! \( -perm -0020 ! -group 0 \) ! -acl \
    -print 2>/dev/null)" ] || return 1
  while [ "$dir" != "/" ]; do
    dir="$(dirname "$dir")"
    [ -z "$(untrusted_dir "$dir")" ] || return 1
  done
  [ "$(head -c 64 "$flag" | tr -d '[:space:]')" = "$PAYLOAD_RELEASE_SEQ" ]
}
# <<< one-shot downgrade flag

if ! select_root_python; then
  if [ -n "$REFUSED_PY" ]; then
    report_refused_python
    fail "no root-owned CPython 3.12 to run the verifier with (see above)"
  fi
  fail "CPython 3.12 (all-users install) not found at $FRAMEWORK_PY, $USR_LOCAL_PY, $BREW_ARM_PY or $BREW_INTEL_PY (the exact paths preinstall validated); install the python.org 3.12 framework installer and re-run"
fi

# The verifier, the profiles.py it imports and the release key decide what
# root installs next, so they get the interpreter's check too: their
# directories, every directory above them and wherever their symlinks lead
# must be root's alone (where Homebrew owns /usr/local/lib, as on Intel Macs,
# whoever can rename a directory there could swap in a verifier that prints
# PASSED). The check proves the RESOLVED directories, so everything below uses
# those: the paths as given may lead through a symlink in a directory another
# account can write, which could be re-pointed between the check and the use.
verifier_dir="$(cd "$(dirname "$VERIFIER")" && pwd -P)" || fail "cannot resolve the directory of $VERIFIER"
key_dir="$(cd "$(dirname "$PUBKEY")" && pwd -P)" || fail "cannot resolve the directory of $PUBKEY"
for trust_dir in "$verifier_dir" "$key_dir"; do
  root_only_trees "$trust_dir" \
    || fail "refusing to run the trusted verifier: $UNTRUSTED_WHY. Fix it with: $UNTRUSTED_FIX"
done
VERIFIER="$verifier_dir/$(basename "$VERIFIER")"
PUBKEY="$key_dir/$(basename "$PUBKEY")"

# Anti-rollback: the verifier refuses a bundle that is an OLDER release than
# the installed one ($PREFIX/manifest.json, published by step 7 of the last
# install), so an older signed .pkg cannot bring back code later releases
# fixed. A .pkg built before this check runs its own postinstall, which names
# no installed manifest: the trusted verifier then checks this same file on
# its own (it is this platform's default), so that .pkg is refused too, but
# only here. It has no check in its preinstall (this release's preinstall
# refuses an older payload before it lands), so the Installer has already
# written its bundle folder, share scripts and LaunchDaemon plist and does not
# put them back; the refusal says to re-install the current .pkg. A
# verifier that parses options but has no --installed-manifest
# predates that check and would stop on the unknown option with a bare usage
# error; name the fix instead. One that names the option only in a comment
# gets past this text check, and its argparse then gives it away (below).
OUTDATED_VERIFIER="the trusted verifier at $VERIFIER is an OUTDATED copy (no --installed-manifest option): it cannot refuse a downgrade to an older release. Install verify_bundle.py and profiles.py from this release's trusted channel into $TRUST_DIR, then re-run the installer"
if grep -q -- '"--pubkey"' "$VERIFIER" && ! grep -q -- '"--installed-manifest"' "$VERIFIER"; then
  fail "$OUTDATED_VERIFIER"
fi
# An intended downgrade: the flag file $DOWNGRADE_FLAG, naming this release
# and written by root alone (see downgrade_authorised), used once.
ROLLBACK_ARGS=(--installed-manifest "$PREFIX/manifest.json")
if downgrade_authorised; then
  ROLLBACK_ARGS+=(--allow-downgrade)
  echo "==> postinstall: $DOWNGRADE_FLAG authorises this release: an older release is accepted this once"
fi
rm -f "$DOWNGRADE_FLAG" 2>/dev/null || true

# Execute the verifier under the validated interpreter (it is installed with
# install -m 644 on the documented channel). -I: root-side python never reads
# PYTHON* variables, the user site or the working directory; the verifier puts
# its own directory on sys.path for profiles.py. -S: nor the interpreter's
# site-packages (see the interpreter block); the verifier needs only the
# standard library. $VEXEC is unquoted at the call site: the resolved
# interpreter path contains no spaces.
VEXEC="$PY -I -S"
# Exit code alone is not proof: python3 on an empty, truncated or no-op
# verifier exits 0 without certifying anything. Every other call site (deb
# postinst, install_offline.sh, upgrade_offline.sh, msi verify.ps1) requires
# the literal proof line and the absence of a FAIL: diagnostic; this one was
# the only gap.
VERIFY_OUT="$(mktemp /var/tmp/udbmcp-verify.XXXXXX)"
VRC=0
$VEXEC "$VERIFIER" --bundle "$BUNDLE" --pubkey "$PUBKEY" "${ROLLBACK_ARGS[@]}" >"$VERIFY_OUT" 2>&1 || VRC=$?
cat "$VERIFY_OUT"
# 'rollback refused' or 'rollback check impossible' (an unreadable installed
# manifest): the verifier's advice, --allow-downgrade, is the flag file here.
if [ "$VRC" -ne 0 ] && grep -q '^FAIL: rollback ' "$VERIFY_OUT"; then
  rm -f "$VERIFY_OUT"
  fail "this package is an OLDER release than the one installed, or the installed $PREFIX/manifest.json is unreadable (see above). To install it anyway, run '$ALLOW_DOWNGRADE_CMD' and run the installer again"
fi
if [ "$VRC" -ne 0 ] && grep -q -- 'unrecognized arguments: --installed-manifest' "$VERIFY_OUT"; then
  rm -f "$VERIFY_OUT"
  fail "$OUTDATED_VERIFIER"
fi
if [ "$VRC" -ne 0 ]; then
  rm -f "$VERIFY_OUT"
  fail "bundle verification FAILED — the payload may be tampered or corrupt; nothing will be installed or executed"
fi
if grep -q '^FAIL:' "$VERIFY_OUT" || ! grep -q 'bundle verification PASSED' "$VERIFY_OUT"; then
  rm -f "$VERIFY_OUT"
  fail "trusted verifier exited 0 but did not print 'bundle verification PASSED' (or printed a FAIL line); without explicit proof of verification the bundle is treated as untrusted"
fi
rm -f "$VERIFY_OUT"

# --- step 2: create the _udbmcp service group and user (idempotent) ----------
# Mirrors the Linux udbmcp account: no login shell, no home, hidden from the
# login window. macOS has no groupadd/useradd; use dscl against the local
# directory. A UID/GID is picked at random from the reserved service range
# (400-499, below regular users at 501+), skipping anything already in use.
echo "==> postinstall: ensuring $SERVICE_GROUP service group and $SERVICE_USER service user"

used_ids="$( { dscl . -list /Users UniqueID 2>/dev/null; dscl . -list /Groups PrimaryGroupID 2>/dev/null; } | awk '{print $NF}' | sort -u)"

free_id() {
  # $1 = range start, $2 = range end; prints a free id or returns 1
  local start=$(( $1 + (RANDOM % ($2 - $1 + 1)) ))
  local id
  for id in $(seq "$start" "$2") $(seq "$1" "$((start - 1))"); do
    if ! printf '%s\n' "$used_ids" | grep -qx "$id"; then
      printf '%s\n' "$id"
      return 0
    fi
  done
  return 1
}

if dscl . -read "/Groups/$SERVICE_GROUP" >/dev/null 2>&1; then
  GROUP_GID="$(dscl . -read "/Groups/$SERVICE_GROUP" PrimaryGroupID | awk '{print $2}')"
else
  GROUP_GID="$(free_id 400 499)" || fail "no free GID available in the 400-499 service range for $SERVICE_GROUP"
  dscl . -create "/Groups/$SERVICE_GROUP" || fail "could not create group $SERVICE_GROUP (dscl)"
  dscl . -create "/Groups/$SERVICE_GROUP" PrimaryGroupID "$GROUP_GID"
  dscl . -create "/Groups/$SERVICE_GROUP" RealName "Universal DB MCP service group"
  dscl . -create "/Groups/$SERVICE_GROUP" Password "*"
fi

if dscl . -read "/Users/$SERVICE_USER" >/dev/null 2>&1; then
  :  # already provisioned (upgrade/re-install): keep the existing UID
else
  USER_UID="$(free_id 400 499)" || fail "no free UID available in the 400-499 service range for $SERVICE_USER"
  dscl . -create "/Users/$SERVICE_USER" || fail "could not create user $SERVICE_USER (dscl)"
  dscl . -create "/Users/$SERVICE_USER" UniqueID "$USER_UID"
  dscl . -create "/Users/$SERVICE_USER" PrimaryGroupID "$GROUP_GID"
  dscl . -create "/Users/$SERVICE_USER" RealName "Universal DB MCP service user"
  dscl . -create "/Users/$SERVICE_USER" UserShell /usr/bin/false
  dscl . -create "/Users/$SERVICE_USER" NFSHomeDirectory /var/empty
  dscl . -create "/Users/$SERVICE_USER" Password "*"
  dscl . -create "/Users/$SERVICE_USER" IsHidden 1
fi
dscl . -read "/Users/$SERVICE_USER" >/dev/null 2>&1 || {
  fail "could not create the $SERVICE_USER service account; the launchd daemon runs as this user"
}

# --- step 3: build the venv from the bundle wheelhouse (no index, hashed) ----
echo "==> postinstall: creating virtual environment at $VENV"

# $PY was selected before step 1 by the same code as preinstall (a
# root-owned installation, never a PATH search) and is the interpreter the
# verifier ran under; re-assert the minor version as defense in depth. Every
# root-side run of it below is -I -S, like the verifier; the venv's own
# python needs its site-packages (filled by pip from the verified wheelhouse)
# and runs with -I.
"$PY" -I -S -c 'import sys; assert sys.version_info[:2] == (3, 12), f"CPython 3.12.x required, got {sys.version}"' || {
  fail "CPython 3.12.x is required (the wheelhouse is built for cp312)"
}
"$PY" -I -S -c 'import ensurepip, venv' 2>/dev/null || fail "venv/ensurepip not available in $PY"

if [ ! -d "$PREFIX" ]; then
  # Root-owned 755: the venv is code that root-run tools and the service
  # execute; it must never be owned or writable by anyone else.
  install -d -m 755 -o root -g wheel "$PREFIX"
fi

# --copies: the venv python must be a REAL COPY of the base interpreter, not a
# symlink to it. doctor derives the installed profile from
# Path(sys.executable).resolve().parent.parent / "manifest.json" (published in
# step 7); with a symlinked venv python, resolve() escapes the venv to the
# base framework and doctor never finds the manifest.
#
# Upgrade guard for venvs created by earlier builds with symlinks: venv's
# copier is shutil.copyfile, which writes THROUGH an existing destination
# symlink — copying over the stale links would overwrite the base framework's
# python binary itself. Remove stale symlinks first; venv recreates each name
# as a copy immediately after.
for stale in "$VENV/bin/python" "$VENV/bin/python3" "$VENV/bin/python3."*; do
  if [ -L "$stale" ]; then
    rm -f "$stale"
  fi
done
"$PY" -I -S -m venv --copies "$VENV" || fail "could not create the virtual environment at $VENV"

echo "==> postinstall: installing application from bundle wheelhouse (no index, hashed)"
# Hostile-env neutralization (mirrors scripts/install_offline.sh): a curated
# pip.conf, an index override or proxy variables inherited from the admin's
# session must not be able to redirect these installs to a network source.
# --no-index + --require-hashes make the bundle wheelhouse the only source and
# the shipped runtime.lock the only acceptable resolution.
# --force-reinstall is MANDATORY on upgrades: the app wheel's version string
# does not change between code-only releases (0.1.0 -> 0.1.0), so without it
# pip reports "already satisfied" and leaves the PREVIOUS release's code in
# the venv while the plist/unit around it are new — an install that reports
# success but runs stale code (found live 2026-09-12: the service crash-
# looped because the new HTTP plist met the pre-fix venv).
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY all_proxy || true
env \
  PIP_CONFIG_FILE=/dev/null \
  PIP_DISABLE_PIP_VERSION_CHECK=1 \
  PIP_NO_INDEX=1 \
  PIP_FIND_LINKS="$BUNDLE/wheelhouse" \
  "$VENV/bin/python" -I -m pip --isolated --disable-pip-version-check install \
  --no-index \
  --no-cache-dir \
  --find-links="$BUNDLE/wheelhouse" \
  --only-binary=:all: \
  --require-hashes \
  --force-reinstall \
  -r "$BUNDLE/requirements/runtime.lock" || {
  fail "wheelhouse install failed; the runtime.lock resolution could not be installed from the verified bundle"
}

# --- step 4: smoke check — the FIRST execution of payload code, so it is only
# reached after the step-1 verification passed -------------------------------
echo "==> postinstall: smoke check"
"$VENV/bin/python" -I -m universal_db_mcp version || {
  fail "smoke check failed: the installed package does not respond to 'universal_db_mcp version'"
}

# --- step 4b: short CLI alias on PATH ----------------------------------------
# pip's [project.scripts] entry point lands at $VENV/bin/udbmcp; link it into
# /usr/local/bin so `udbmcp doctor` etc. work without the venv path. Guarded:
# an existing udbmcp that is NOT our symlink (an admin's own wrapper) is never
# clobbered.
echo "==> postinstall: linking udbmcp CLI alias into /usr/local/bin"
install -d -m 0755 /usr/local/bin 2>/dev/null || true
ALIAS="/usr/local/bin/udbmcp"
if [ -e "$ALIAS" ] && [ "$(readlink "$ALIAS" 2>/dev/null)" != "$VENV/bin/udbmcp" ]; then
  echo "    WARNING: $ALIAS already exists and is not our symlink; left untouched." >&2
  echo "         The CLI stays available at $VENV/bin/udbmcp." >&2
elif ! ln -sfn "$VENV/bin/udbmcp" "$ALIAS" 2>/dev/null; then
  # BEST-EFFORT by design: the daemon is already running; a PATH-convenience
  # alias must never abort an otherwise complete install.
  echo "    WARNING: could not create $ALIAS (non-root or read-only /usr/local/bin?)." >&2
  echo "         The CLI stays available at $VENV/bin/udbmcp." >&2
fi

# --- step 5: install config.yaml ONLY if absent (never clobber the admin's) --
echo "==> postinstall: installing config template (only if absent)"
if [ ! -f "$CONFIG" ]; then
  [ -f "$BUNDLE/config-templates/config.yaml" ] || fail "config template missing from the bundle at $BUNDLE/config-templates/config.yaml"
  install -d -m 755 -o root -g wheel "$CONFIG_DIR"
  # Root-owned, group-readable by the service account only: the config may
  # reference credentials; the service runs as $SERVICE_USER and must read it.
  install -m 640 -o root -g "$SERVICE_GROUP" "$BUNDLE/config-templates/config.yaml" "$CONFIG"
else
  echo "    $CONFIG already present — left untouched (never clobber)"
fi

# --- step 5b: HTTP bearer token for the launchd daemon -----------------------
# The daemon runs `serve --transport http` (launchd gives a daemon no stdin
# client, so the config's default stdio transport would read EOF and exit 0);
# the bearer token is the only authentication on the listener. Provision a
# fresh token ONLY if absent (never clobber the admin's), owned by the
# service account, mode 0600 — the server's secret-file permission rule
# rejects any group/other access bit. The token value is never printed.
TOKEN_FILE="$CONFIG_DIR/http-token"
# -s (non-empty), not -f: a zero-length leftover (e.g. a previous install was
# killed between file creation and token append) must be REGENERATED, not
# preserved — the server refuses an empty token file, so keeping it would
# leave a sticky broken state misdescribed as an admin-owned token.
if [ -s "$TOKEN_FILE" ]; then
  echo "    $TOKEN_FILE already present — left untouched (never clobber)"
else
  [ ! -e "$TOKEN_FILE" ] || echo "    $TOKEN_FILE is empty; regenerating it"
  install -m 0600 -o "$SERVICE_USER" -g "$SERVICE_GROUP" /dev/null "$TOKEN_FILE" \
    || fail "could not create the HTTP bearer token file at $TOKEN_FILE"
  "$PY" -I -S -c 'import secrets; print(secrets.token_hex(32))' >> "$TOKEN_FILE" \
    || fail "could not generate the HTTP bearer token (python secrets)"
  echo "    generated $TOKEN_FILE (0600 $SERVICE_USER:$SERVICE_GROUP)"
fi

# --- step 6: state and log directories, owned by the service account ---------
echo "==> postinstall: provisioning state and log directories"
# 0750: audit trail and metadata cache contain SQL text / schema metadata;
# only the service account (and root) may read them.
install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 0750 "$STATE_DIR" "$LOG_DIR" || {
  fail "could not create $STATE_DIR and $LOG_DIR (the service's state and log directories)"
}
# An older release's root site check (sudo udbmcp site-check or doctor) could
# leave the audit log, its .lock sidecar or a rotated backup in $LOG_DIR owned
# by root; this release no longer repairs them at run time, so under
# audit_fail_closed the daemon would refuse every audited call. Hand them back
# before launchd starts it. $SERVICE_USER owns the directory, so each entry is
# opened without following links and checked on the open descriptor (a
# regular file, one link, owned by root) before fchown: a symlink, or a name
# that is a second link to another file, is left alone. Best effort.
# >>> hand root-owned audit files back: identical in the deb postinst, the pkg postinstall, install_offline.sh and upgrade_offline.sh
"$PY" -I -S - "$LOG_DIR" "$SERVICE_USER" <<'PYEOF' || echo "WARNING: could not hand root-owned audit files in $LOG_DIR back to $SERVICE_USER" >&2
import os
import pwd
import stat
import sys

ROOT = 0
log_dir, account = sys.argv[1], sys.argv[2]
owner = pwd.getpwnam(account)
try:
    # Logs moved to another volume and linked back: the link is followed only
    # when root owns it and the directory it is in, so no other account made or
    # can re-point it. Where it leads is opened like the name itself.
    if os.path.islink(log_dir):
        if os.lstat(log_dir).st_uid != ROOT or os.stat(os.path.dirname(os.path.abspath(log_dir))).st_uid != ROOT:
            sys.exit(f"{log_dir}: a symlink another account could have made or re-pointed")
        log_dir = os.path.realpath(log_dir)
    dir_fd = os.open(log_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
except OSError as exc:
    sys.exit(f"{log_dir}: {exc.strerror}")
try:
    for name in sorted(os.listdir(dir_fd)):
        if not name.startswith("audit.jsonl"):
            continue
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
        except OSError:
            continue  # a symlink, or gone
        try:
            st = os.fstat(fd)
            if stat.S_ISREG(st.st_mode) and st.st_nlink == 1 and st.st_uid == ROOT:
                os.fchmod(fd, 0o600)  # the audit writer's own mode: it opens the file read-write
                os.fchown(fd, owner.pw_uid, owner.pw_gid)
                print(f"==> {log_dir}/{name} was owned by root; handed back to {account}")
        finally:
            os.close(fd)
except OSError as exc:
    sys.exit(f"{log_dir}: {exc.strerror}")
finally:
    os.close(dir_fd)
PYEOF
# <<< hand root-owned audit files back

# The shipped config template references this demo database and doctor marks a
# missing SQLite data file FATAL, so without it the documented post-install
# check fails on every clean install. Never clobber a seeded one (an empty
# file is an empty SQLite database). $SERVICE_USER owns $STATE_DIR, so root
# never follows a link there: the demo directory and the file are opened
# without following links, the file is created only if no name is there yet,
# and both are handed over on their descriptors.
# BEST-EFFORT by design: this is a convenience file for the template's example
# connection, never a reason to fail an otherwise complete install.
DEMO_DB="$STATE_DIR/demo/finlink_demo.db"
if [ ! -f "$DEMO_DB" ]; then
  # >>> create the demo database: identical in install_offline.sh and the pkg postinstall
  "$PY" -I -S - "$STATE_DIR" "$SERVICE_USER" <<'PYEOF' 2>/dev/null || {
import os
import pwd
import stat
import sys

state_dir, account = sys.argv[1], sys.argv[2]
owner = pwd.getpwnam(account)
state_fd = os.open(state_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    try:
        os.mkdir("demo", 0o750, dir_fd=state_fd)
    except FileExistsError:
        pass
    demo_fd = os.open("demo", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=state_fd)
finally:
    os.close(state_fd)
try:
    os.fchown(demo_fd, owner.pw_uid, owner.pw_gid)
    os.fchmod(demo_fd, 0o750)
    try:
        fd = os.open("finlink_demo.db", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o640, dir_fd=demo_fd)
    except FileExistsError:
        # never clobbered; anything but a regular file there is reported
        st = os.stat("finlink_demo.db", dir_fd=demo_fd, follow_symlinks=False)
        sys.exit(0 if stat.S_ISREG(st.st_mode) else 1)
    try:
        os.fchown(fd, owner.pw_uid, owner.pw_gid)
        os.fchmod(fd, 0o640)
    finally:
        os.close(fd)
finally:
    os.close(demo_fd)
PYEOF
    echo "WARNING: could not create the demo database at $DEMO_DB; doctor will report the" >&2
    echo "         template's demo_sqlite connection as a missing data file." >&2
  }
  # <<< create the demo database
fi

# --- step 6b: no root rotation job over the service's log directory ----------
# Earlier releases installed a newsyslog(8) rule for $LOG_DIR/*.log at
# /etc/newsyslog.d/udbmcp.conf. The system newsyslog job runs it as root every
# hour, and a rotation renames, chmods and chowns each archive by name,
# following a symlink there: $SERVICE_USER owns $LOG_DIR, so it chose which of
# root's files became its own. The daemon caps its launchd logs itself now
# (serve, as $SERVICE_USER), so the rule and its payload copy are removed.
# FAIL CLOSED: a rule left behind keeps root acting on names the service
# account controls.
NEWSYSLOG_DST="/etc/newsyslog.d/udbmcp.conf"
for stale in "$NEWSYSLOG_DST" "$PREFIX/share/udbmcp.newsyslog.conf"; do
  if [ -e "$stale" ] || [ -L "$stale" ]; then
    rm -f -- "$stale" || fail "could not remove $stale, an earlier release's newsyslog rule over $LOG_DIR; remove it and install again"
    echo "==> postinstall: removed $stale (an earlier release's newsyslog rule; the daemon caps its own logs)"
  fi
done

# --- step 6c: launchd's output files, where only root can write --------------
# launchd opens the daemon's StandardOutPath and StandardErrorPath itself, as
# root, before the daemon becomes $SERVICE_USER, creating them and following
# a symlink there. Earlier releases kept them in $LOG_DIR, which
# $SERVICE_USER owns: a link it put at server.log led root's open to any
# file. The plist names $LAUNCHD_LOG_DIR now: only root can write it or any
# directory above it. Each file is $SERVICE_USER's, so the daemon can cap it
# (serve empties only a file its account owns); it can do no more than
# write to it there. FAIL CLOSED: the daemon is not started yet.
echo "==> postinstall: provisioning $LAUNCHD_LOG_DIR (launchd's stdout and stderr files for the daemon)"
[ ! -L "$LAUNCHD_LOG_DIR" ] || fail "$LAUNCHD_LOG_DIR is a symlink: launchd opens the daemon's output files there as root; remove it and install again"
install -d -m 0755 -o root -g wheel "$LAUNCHD_LOG_DIR" || fail "could not create $LAUNCHD_LOG_DIR (launchd's output files for the daemon)"
above="$LAUNCHD_LOG_DIR"
while :; do
  hit="$(untrusted_dir "$above")"
  [ -z "$hit" ] || fail "$hit is not owned by root, or another account can write to it (write bits or an ACL), and launchd opens the daemon's output files in $LAUNCHD_LOG_DIR as root. Fix: sudo chown root:wheel $hit; sudo chmod go-w $hit; sudo chmod -N $hit"
  [ "$above" != "/" ] || break
  above="$(dirname "$above")"
done
for out in "$LAUNCHD_LOG_DIR/server.log" "$LAUNCHD_LOG_DIR/server.err.log"; do
  if [ -L "$out" ] || { [ -e "$out" ] && [ ! -f "$out" ]; }; then
    fail "$out is not a regular file: launchd opens it as root; remove it and install again"
  elif [ -e "$out" ]; then
    # launchd creates a missing one as root; the daemon caps only its own
    { chown "$SERVICE_USER:$SERVICE_GROUP" "$out" && chmod 0640 "$out"; } \
      || echo "WARNING: could not hand $out to $SERVICE_USER; the daemon caps only a file its account owns" >&2
  else
    install -m 0640 -o "$SERVICE_USER" -g "$SERVICE_GROUP" /dev/null "$out" || fail "could not create $out"
  fi
done

# --- step 7: publish manifest.json next to the venv (doctor hook) ------------
# doctor derives the installed profile from this file instead of guessing from
# the running platform (it looks at Path(sys.executable).resolve().parent.parent,
# which lands on $PREFIX only because step 3 built the venv with --copies).
# Guarded: a bundle without a manifest must not fail the install — doctor
# falls back to an honest platform description.
if [ -f "$BUNDLE/manifest.json" ]; then
  install -m 644 -o root -g wheel "$BUNDLE/manifest.json" "$PREFIX/manifest.json"
fi

# --- step 7b: GUI app payload prerequisite (fail closed BEFORE the daemon) ---
# Checked here rather than in step 9 so a missing payload script aborts the
# install BEFORE the daemon is started: past that point fail()'s "nothing was
# started" message would be false.
APP_SRC="$PREFIX/share/configure_agents_app.sh"
[ -f "$APP_SRC" ] || fail "GUI app script missing from the payload at $APP_SRC"

# --- step 8: bootstrap the launchd daemon (fail closed) ----------------------
echo "==> postinstall: bootstrapping launchd daemon $LABEL"
[ -f "$PLIST" ] || fail "launchd plist missing at $PLIST"
# On an upgrade the daemon may already be bootstrapped; bootout first so the
# (possibly changed) plist is picked up. Every failure here is FATAL: a
# bootout that silently fails leaves the stale daemon running with the OLD
# plist while its payload and venv have just been replaced, and reporting
# that as success would be a masked failed upgrade — the exact failure this
# step exists to prevent. There is no already-bootstrapped tolerance.
if launchctl print "system/$LABEL" >/dev/null 2>&1; then
  launchctl bootout "system/$LABEL" || {
    fail "launchctl bootout system/$LABEL failed; the running daemon must be unloaded before the upgraded plist can take effect"
  }
  # bootout teardown is ASYNCHRONOUS: it can report success while the job is
  # still registered, and an immediate bootstrap then fails (seen live
  # 2026-09-13: an upgrade died at this step and left the service unloaded).
  # Poll (bounded) until the job is actually gone before re-registering.
  waited=0
  while launchctl print "system/$LABEL" >/dev/null 2>&1 && [ "$waited" -lt 10 ]; do
    sleep 1
    waited=$((waited + 1))
  done
fi
# bootstrap can also lose the race against a just-torn-down registry entry:
# retry (bounded) before giving up. Every retry is silent; only the final
# failure is fatal, with the manual command as the remedy.
bootstrap_attempt=0
until launchctl bootstrap system "$PLIST" 2>/dev/null; do
  bootstrap_attempt=$((bootstrap_attempt + 1))
  if [ "$bootstrap_attempt" -ge 3 ]; then
    fail "launchctl bootstrap system $PLIST failed after 3 attempts; start it manually with: launchctl bootstrap system $PLIST"
  fi
  sleep 2
done

# --- step 9: assemble the /Applications GUI wrapper (agent configuration) ----
# The dialog logic lives in the root-owned VERIFIED payload
# ($PREFIX/share/configure_agents_app.sh, staged by build_pkg.sh; its
# presence was a fatal prerequisite in step 7b). This is a thin launcher .app
# so the flow is reachable from Finder as the logged-in user - agent harness
# configs are per-user files and must never be written by the root
# postinstall itself. The dialogs ask before anything is written
# (configure-agents' ask-before-write contract).
# BEST-EFFORT by design: the daemon is ALREADY RUNNING here, so an /Applications
# failure must not abort the install (fail() would misreport a live service as
# a failed install) - it degrades to a loud WARNING with the manual path.
echo "==> postinstall: installing 'Configure UniversalDB MCP.app' (agent configuration GUI)"
APP_DIR="/Applications/Configure UniversalDB MCP.app"
# /Applications is the admin group's to write (root:admin 0775): what is at
# APP_DIR, or below it, may be links another admin-group process made, which
# cat >, chown and chmod as root would follow. So the .app is built in a new
# directory only root can write (mktemp -d, 0700, in the sticky /var/tmp,
# where nobody else can rename what root makes; never wherever TMPDIR points)
# and renamed into place over whatever was there, which is removed first
# (rm -rf removes a link, never what it leads to, and a rename never follows
# one either).
APP_BUILD_BASE="/var/tmp"
APP_BUILD="$(mktemp -d "$APP_BUILD_BASE/udbmcp-app.XXXXXX" 2>/dev/null)" || APP_BUILD=""
APP_NEW="$APP_BUILD/Configure UniversalDB MCP.app"
if [ -z "$APP_BUILD" ] || ! install -d -m 0755 "$APP_NEW/Contents/MacOS" "$APP_NEW/Contents/Resources" 2>/dev/null; then
  echo "WARNING: could not create '$APP_DIR'; the agent-configuration GUI is" >&2
  echo "         unavailable (the service itself is running). The dialog logic" >&2
  echo "         can be run directly: $APP_SRC" >&2
else
cat > "$APP_NEW/Contents/Info.plist" <<'INFO_PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Configure UniversalDB MCP</string>
	<key>CFBundleDisplayName</key>
	<string>Configure UniversalDB MCP</string>
	<key>CFBundleIdentifier</key>
	<string>com.udbmcp.configure-agents</string>
	<key>CFBundleExecutable</key>
	<string>udbmcp-configure</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
INFO_PLIST
cat > "$APP_NEW/Contents/MacOS/udbmcp-configure" <<WRAPPER
#!/bin/bash
# \$@ must survive as LITERAL wrapper args: this heredoc is unquoted so
# \$PREFIX expands to the (sandbox-rewritten) install prefix at write time.
exec "$PREFIX/share/configure_agents_app.sh" "\$@"
WRAPPER
chmod 0755 "$APP_NEW" "$APP_NEW/Contents"
chmod 0644 "$APP_NEW/Contents/Info.plist"
chmod 0755 "$APP_NEW/Contents/MacOS/udbmcp-configure"
chown -R root:wheel "$APP_NEW" 2>/dev/null || true
if ! { rm -rf "$APP_DIR" \
       && "$PY" -I -S -c 'import os, sys; os.rename(sys.argv[1], sys.argv[2])' "$APP_NEW" "$APP_DIR"; }; then
  echo "WARNING: could not put '$APP_DIR' in place; the agent-configuration GUI is" >&2
  echo "         unavailable (the service itself is running). The dialog logic" >&2
  echo "         can be run directly: $APP_SRC" >&2
fi
fi
[ -z "$APP_BUILD" ] || rm -rf "$APP_BUILD"

echo "==> postinstall complete. Next steps:"
echo "    1. Open 'Configure UniversalDB MCP' in /Applications to register your agent harnesses (it asks before writing)."
echo "    2. Edit $CONFIG (the template was installed only if absent)."
echo "    3. Run: $VENV/bin/python -m universal_db_mcp doctor"
echo "    4. Server logs: $LOG_DIR/http.log; launchd's stdout and stderr: $LAUNCHD_LOG_DIR (launchd label: system/$LABEL)"
exit 0
