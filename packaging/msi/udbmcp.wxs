<?xml version="1.0" encoding="UTF-8"?>
<!--
  UniversalDB MCP - Windows MSI authoring (WiX v4/v5 schema, namespace below).

  Trust model (MUST be preserved by every change here):
    * The payload installed into INSTALLFOLDER\bundle is the SIGNED offline
      bundle exactly as produced by scripts/prepare_offline_bundle.py. Nothing
      in this package executes payload bits before the deferred
      verify_bundle.py custom action has re-verified the installed tree with
      the admin-distributed release public key (see plan Phase 5).
    * The release public key is NEVER embedded in this package. The admin
      provisions it out-of-band, together with the trusted verifier, into the
      trust directory BEFORE running the MSI; verification fails closed if it
      is absent. That trust directory is passed to verify.ps1 EXPLICITLY as
      TRUST_DIR=[ProgramFiles64Folder]udbmcp-trust (see VerifyBundleCA): it
      must live where only administrators can create/write, never in a
      world-squattable location such as C:\ProgramData.
    * The venv build custom action MUST run pip in no-index mode with
      require-hashes and PIP_CONFIG_FILE neutralized
      (see packaging/msi/custom/*.ps1).

  Build-time inputs (filled by scripts/package/build_msi.sh; do not hardcode):
    * -define ProductVersion=<manifest release_seq as major.minor.build>
    * -define ConfigTemplateSource=<path to staged config template> and
      -define ConfigTemplateGuid=<stable GUID for the config component>
    * -define CustomActionScriptsDir=<staged copy of packaging/msi/custom/>
      (the deferred custom action scripts below are shipped inside the MSI)
    * folders.wxi, generated by build_msi.sh from
      packaging/msi/custom/folders.ps1 (included below; it defines the
      property CheckFoldersCA runs as a script: that check runs before
      anything is installed, so its script cannot be an installed file)
    * -arch x64 (ProgramFiles64Folder resolves to "C:\Program Files").
    * The staged signed bundle is harvested by build_msi.sh's built-in
      fragment generator into harvest.wxi (included below as a fragment;
      build_msi.sh GENERATES that file, it is not authored by hand). `heat`
      is not part of the WiX v4+ `wix` CLI, so the harvest is generated
      natively; its components land under DirectoryRef Id="BundleDir" and
      resolve File/@Source through the -define BundleSourceDir variable.

  Validation on the staging host: xmllint, noout mode, on packaging/msi/udbmcp.wxs
  (syntactic only; full compilation requires `wix build` from Phase 0).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Build-time overrides (scripts/package/build_msi.sh) pass -define flags
    for ProductVersion and ConfigTemplateSource. Every default here is
    therefore guarded with <?ifndef>: an unguarded in-file define OVERWRITES
    the command-line value (with only a preprocessor warning), which would
    silently stamp a stale version or placeholder config path into the MSI.
  -->
  <?ifndef ProductVersion ?>
  <?define ProductVersion = "0.1.0" ?>
  <?endif?>
  <?ifndef ConfigTemplateSource ?>
  <!-- Overridden by build_msi.sh: -define ConfigTemplateSource=<abs path> -->
  <?define ConfigTemplateSource = "config-template-placeholder.yaml" ?>
  <?endif?>
  <?ifndef ConfigTemplateGuid ?>
  <?define ConfigTemplateGuid = "5EE39CAC-D6B9-4BFA-A3EC-8BA64CE51A2B" ?>
  <?endif?>

  <Package
      Name="UniversalDB MCP"
      Manufacturer="universal-db-mcp maintainers"
      Version="$(var.ProductVersion)"
      UpgradeCode="8E2F9A9E-7214-4937-B72F-262CBC7DD1EA"
      InstallerVersion="500"
      Scope="perMachine"
      Language="1033"
      Compressed="yes">

    <!--
      Scope="perMachine" is the WiX v4/v5 name of the v3 InstallScope="perMachine".
      UpgradeCode is FROZEN across all future releases of this product line;
      changing it breaks upgrade/downgrade detection.
    -->
    <!-- ProductVersion is the signed manifest's release_seq (build_msi.sh),
         so a later release always has a higher version, and every MSI
         refuses to install over a newer one (DowngradeErrorMessage): those
         published before release_seq (0.1.0) included, whose verify action
         cannot refuse an older release itself. AllowSameVersionUpgrades: a
         rebuild of the same bundle keeps its version, and without this it is
         not detected as related: the old product is never removed and two
         entries share one install folder - the Windows shape of the
         stale-code incident the .deb avoids with a revision suffix. -->
    <MajorUpgrade
        Schedule="afterInstallValidate"
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Prerequisite: an all-users (per-machine) CPython 3.12 from python.org.
      Per-machine installers write HKLM\SOFTWARE\Python\PythonCore\3.12\InstallPath
      (PEP 514 layout); a per-user install only writes HKCU, so this check
      deliberately enforces the all-users prerequisite. Bitness="always64"
      reads the 64-bit registry view of the x64 MSI (the WiX v4/v5 spelling;
      the v3 attribute was Win64="yes"). "Installed OR" keeps
      uninstall/repair working even if Python was later removed.
    -->
    <Property Id="CPYTHON312" Secure="yes">
      <RegistrySearch
          Id="CPython312PerMachineInstallPath"
          Root="HKLM"
          Key="SOFTWARE\Python\PythonCore\3.12\InstallPath"
          Type="raw"
          Bitness="always64" />
    </Property>
    <!-- WiX v4/v5 renamed the v3 <LaunchCondition> child of <Package> to
         <Launch>; it must stay a direct child of Package. -->
    <Launch
        Condition="Installed OR CPYTHON312"
        Message="CPython 3.12 (python.org, all-users) is required. Install the 64-bit CPython 3.12 from python.org for all users before running this installer." />

    <!--
      Optional service-account override for the deferred DoctorSmokeCA and
      RegisterServiceCA (public property, so admins may pass e.g.
      UDBMCP_SERVICE_ACCOUNT="NT AUTHORITY\NetworkService" on the msiexec
      command line). Empty by default: the actions then fall back to the
      machine-scope UDBMCP_SERVICE_ACCOUNT environment value, then to the
      account the service is registered under (UDBMCPREGISTEREDACCOUNT
      below), and finally to LocalSystem. Secure="yes" lets the value cross
      from the msiexec client to the server side of this per-machine install,
      where the deferred actions run. It must come from an elevated msiexec:
      the AdminUser Launch condition below refuses it from anybody else, and
      a value with a double quote or a trailing backslash is refused before
      anything is installed; service.ps1 also rejects quotes/line breaks
      (fail closed).
    -->
    <Property Id="UDBMCP_SERVICE_ACCOUNT" Secure="yes" />

    <!--
      The account the udbmcp service is registered under when this install
      starts (the service key's ObjectName), for the deferred DoctorSmokeCA
      and RegisterServiceCA. msiexec keeps no property between runs, so a
      repair or upgrade that does not pass UDBMCP_SERVICE_ACCOUNT again used
      to fall back to LocalSystem: the actions then took the running
      service's token and its Modify on logs\ away. AppSearch reads it
      before anything else runs, and so before a major upgrade's
      RemoveExistingProducts (afterInstallValidate) lets the old product's
      RemoveServiceCA delete the service. Windows Installer requires a
      search property to be public (upper case: WiX refuses anything else
      with WIX0012), and Secure: with a user interface AppSearch runs in
      the client's UI sequence only, and only Secure properties reach the
      server side where the deferred actions run. Being public, msiexec
      can set it too, and AppSearch keeps such a value when the service key
      is absent; it needs no AdminUser condition all the same (a standard
      user's repair must keep the account it found), because the actions
      keep an account they were not given only when logs\ grants it write
      access, as the install that registered the service under it did:
      anything else could only come from the command line, and is refused.
      They also refuse to keep an account that signs in with a password
      (its password cannot be read back), and refuse to fall back to
      LocalSystem when logs\ shows the service ran as another account (the
      service is gone, e.g. after an uninstall): the property must name the
      account then.
    -->
    <Property Id="UDBMCPREGISTEREDACCOUNT" Secure="yes">
      <RegistrySearch
          Id="UdbmcpServiceObjectName"
          Root="HKLM"
          Key="SYSTEM\CurrentControlSet\Services\udbmcp"
          Name="ObjectName"
          Type="raw"
          Bitness="always64" />
    </Property>

    <!--
      Anti-rollback override for the deferred VerifyBundleCA. verify.ps1
      gives the trusted verifier the installed release's manifest (recorded
      by RegisterServiceCA at [ProgramFiles64Folder]UniversalDB MCP\manifest.json,
      whatever INSTALLFOLDER is) and the verifier refuses a bundle that is an
      OLDER release. The MSI itself already refuses to install over a newer
      version (MajorUpgrade below; ProductVersion follows the release order),
      so a downgrade means uninstalling first: the record stays. An
      administrator who means to downgrade then passes UDBMCP_ALLOW_DOWNGRADE=1
      on that msiexec command line; it reaches verify.ps1 as ALLOW_DOWNGRADE,
      the LAST key of its CustomActionData (so it applies to that one run: no
      machine-wide variable stays on), and becomes the verifier's
      allow-downgrade option. Any other value is refused here before anything
      is installed: one holding a ';' would add CustomActionData keys of the
      caller's choosing (verify.ps1 also refuses any key after
      ALLOW_DOWNGRADE).
    -->
    <Property Id="UDBMCP_ALLOW_DOWNGRADE" Secure="yes" />
    <Launch
        Condition="NOT UDBMCP_ALLOW_DOWNGRADE OR UDBMCP_ALLOW_DOWNGRADE=&quot;1&quot;"
        Message="UDBMCP_ALLOW_DOWNGRADE may only be 1 (accept an older release than the installed one for this install) or unset." />

    <!--
      Who may pass the two properties above. Being Secure, they reach the
      SYSTEM custom actions from a standard user's repair of this
      per-machine product too, wherever that repair runs without a UAC
      prompt (a host without the September 2024 Windows Installer change,
      CVE-2024-38014, or with it turned off by DisableLUAInRepair): the
      named account would get read access to the config folder and the
      token and Modify on logs\, and an older release would be accepted.
      MSIUSEREALADMINDETECTION=1 makes Windows Installer set AdminUser for a
      real administrator only (without it, AdminUser is set for every user),
      and the Launch condition takes either property from an administrator
      only. Run msiexec from an elevated prompt to pass them.
    -->
    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />
    <Launch
        Condition="AdminUser OR NOT (UDBMCP_SERVICE_ACCOUNT OR UDBMCP_ALLOW_DOWNGRADE)"
        Message="UDBMCP_SERVICE_ACCOUNT and UDBMCP_ALLOW_DOWNGRADE are accepted from an administrator only: run msiexec from an elevated command prompt." />

    <!--
      The account is embedded between double quotes in the powershell.exe
      command lines of DoctorSmokeCA and RegisterServiceCA: a double quote
      in it would end the argument and add parameters of the caller's
      choosing (-ServiceName, -ServicePassword) that service.ps1 never sees
      as part of the account, and a trailing backslash would escape the
      closing quote. A condition cannot spell a double quote in a literal,
      so a private property (msiexec cannot set one) holds it.
    -->
    <Property Id="UdbmcpQuoteChar" Value="&quot;" />
    <Launch
        Condition="NOT (UDBMCP_SERVICE_ACCOUNT &gt;&lt; UdbmcpQuoteChar OR UDBMCP_SERVICE_ACCOUNT &gt;&gt; &quot;\&quot;)"
        Message="UDBMCP_SERVICE_ACCOUNT may not contain a double quote or end with a backslash." />

    <!--
      CheckFoldersCA (below) passes INSTALLFOLDER to PowerShell between
      single quotes: one in the folder's name would end the string and run
      the rest as code. Refused before anything is installed.
    -->
    <Launch
        Condition="NOT (INSTALLFOLDER &gt;&lt; &quot;'&quot;)"
        Message="INSTALLFOLDER may not contain a single quote." />

    <!--
      The folder check CheckFoldersCA runs (packaging/msi/custom/folders.ps1,
      UTF-8, base64): build_msi.sh generates folders.wxi from that script,
      which defines the private property UdbmcpFolderCheck. The script is not
      installed: it runs before anything is (see CheckFoldersCA).
    -->
    <?include "folders.wxi" ?>

    <!--
      Directory tree. The signed-bundle payload under BundleDir is NOT
      authored here: build_msi.sh harvests the staged signed bundle with
      heat into harvest.wxi, whose Fragment defines ComponentGroup
      Id="HarvestedBundleComponents" with DirectoryRef Id="BundleDir"
      components (Guid="*" heat-style). These components must carry no
      custom actions or conditions that could run payload early.
    -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="UniversalDB MCP">
        <Directory Id="BundleDir" Name="bundle" />
        <!--
          The deferred custom action scripts (packaging/msi/custom/*.ps1),
          staged by build_msi.sh and resolved here via -define
          CustomActionScriptsDir. They are installed OUTSIDE the bundle
          directory (INSTALLFOLDER\scripts is a SIBLING of
          INSTALLFOLDER\bundle): verify.ps1 refuses to run from inside the
          bundle — a verifier shipped in the payload would be a tampered
          verifier that prints PASSED — and nothing from INSTALLFOLDER\bundle
          may execute before verification has passed anyway. Each script is
          its own single-file component (WiX generates a stable GUID).
        -->
        <Directory Id="ScriptsDir" Name="scripts">
          <Component Id="VerifyPs1Component" Guid="*">
            <File Id="VerifyPs1File" Name="verify.ps1"
                  Source="$(var.CustomActionScriptsDir)/verify.ps1" KeyPath="yes" />
          </Component>
          <Component Id="VenvPs1Component" Guid="*">
            <File Id="VenvPs1File" Name="venv.ps1"
                  Source="$(var.CustomActionScriptsDir)/venv.ps1" KeyPath="yes" />
          </Component>
          <Component Id="DoctorPs1Component" Guid="*">
            <File Id="DoctorPs1File" Name="doctor.ps1"
                  Source="$(var.CustomActionScriptsDir)/doctor.ps1" KeyPath="yes" />
          </Component>
          <Component Id="ServicePs1Component" Guid="*">
            <File Id="ServicePs1File" Name="service.ps1"
                  Source="$(var.CustomActionScriptsDir)/service.ps1" KeyPath="yes" />
          </Component>
          <Component Id="UninstallPs1Component" Guid="*">
            <File Id="UninstallPs1File" Name="uninstall.ps1"
                  Source="$(var.CustomActionScriptsDir)/uninstall.ps1" KeyPath="yes" />
          </Component>
        </Directory>
        <Directory Id="ConfigTemplatesDir" Name="config-templates" />
      </Directory>
    </StandardDirectory>

    <!--
      Machine-wide configuration: ProgramData\UniversalDB MCP\config.yaml
      installed once, NeverOverwrite="yes" so repairs and upgrades never
      clobber admin-edited configuration, and Permanent="yes" so nothing
      removes it: MajorUpgrade (afterInstallValidate) uninstalls the old
      product completely before the new one installs, and without Permanent
      that uninstall deleted the admin's config.yaml and the new product
      installed the template in its place. An uninstall keeps it too
      (mirrors the .deb conffile and macOS pkg "install only if absent"
      semantics); a later install finds it and keeps it.
    -->
    <!-- CommonAppDataFolder is the MSI standard directory for
         C:\ProgramData (there is no "ProgramDataFolder" standard directory;
         the WiX compiler rejects any other Id under StandardDirectory). -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ProgramDataUdbmcpDir" Name="UniversalDB MCP">
        <!--
          This folder holds config.yaml, the secrets it references and the
          HTTP bearer token that RegisterServiceCA provisions (the listener's
          only credential). C:\ProgramData's inheritable DACL gives
          BUILTIN\Users read access and lets any local user create entries
          (and own them), so the folder gets its OWN protected DACL, by SID:
          SYSTEM and Administrators Full Control, nothing inherited. The SDDL
          deliberately names NO owner or group: MsiLockPermissionsEx applies
          them during CreateFolders, so an owner here would hand a folder a
          non-admin pre-created to Administrators and hide who made it.
          CreateFolders writes that DACL as LocalSystem wherever the path
          leads: CheckFoldersCA, just before it, refuses a folder that is a
          junction or symbolic link, that is not an administrator's, or that
          a non-administrator could move (it, or any folder above it), and
          creates a missing one with this DACL itself (folders.ps1). Entries
          already in the folder
          keep their owner (a planted config.yaml is kept by
          NeverOverwrite), and on an upgrade any local user could create
          entries there under the old inherited DACL. doctor.ps1 and
          service.ps1 therefore refuse the folder, or any entry at any depth
          below it, when neither SYSTEM, Administrators nor an administrator
          owns it or when it is a junction or symbolic link; below logs\ the
          service account (UDBMCP_SERVICE_ACCOUNT, else the one the service
          is registered under; both are passed to both actions) may own what
          it wrote. An entry whose own ACEs let anybody else
          write it is refused too. A token service.ps1 would replace is
          removed by doctor.ps1 before the payload doctor (which refuses it)
          runs, and provisioned again by service.ps1. doctor.ps1 makes logs\
          (the service's state folder: its audit log, the Windows default
          audit_path) when it is missing, after those checks: a folder
          authored here would get its DACL in CreateFolders, before any
          check, through a junction a local user planted in an upgraded
          folder. service.ps1 then re-applies this DACL with Set-Acl (which
          propagates it to the entries already there and drops a previous
          service account's access), re-applies it to logs\, adds read
          access to the folder and Modify on logs\ for a dedicated service
          account (the account is only known at install time), walks the
          folder again, and gives the token file its own protected DACL,
          owned by Administrators. The permission lives
          in its own component: ConfigYamlComponent is NeverOverwrite (and
          Permanent), so on an upgrade that keeps config.yaml it is not reinstalled and would
          not re-apply the DACL.
          A component whose key path is a directory needs a fixed GUID.
          PermissionEx (MsiLockPermissionsEx) needs InstallerVersion 500.
        -->
        <Component
            Id="ProgramDataUdbmcpDirAclComponent"
            Guid="EC9C5A13-32AA-47B4-9108-F9D2B7EA8B18"
            KeyPath="yes">
          <CreateFolder>
            <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
          </CreateFolder>
        </Component>
        <Component
            Id="ConfigYamlComponent"
            Guid="$(var.ConfigTemplateGuid)"
            NeverOverwrite="yes"
            Permanent="yes">
          <File
              Id="ConfigYamlFile"
              Name="config.yaml"
              Source="$(var.ConfigTemplateSource)"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!--
      ServiceControl / Service elements are DELIBERATELY ABSENT.
      WiX ServiceInstall/ServiceControl require the service executable to
      exist at authoring time, but the venv python.exe that runs
      `python -m universal_db_mcp serve` is created by a custom action
      during installation, so it does not exist when this .wxs is compiled.
      The service is therefore registered by the deferred RegisterServiceCA
      custom action below, which runs service.ps1 to invoke:
        * sc.exe create udbmcp binPath= "<venv>\Scripts\python.exe" -I -m universal_db_mcp serve (HTTP transport) start= auto
        * sc.exe failure udbmcp reset= 86400 actions= restart/60000
      (mirroring packaging/systemd/universal-db-mcp.service Restart=on-failure),
      and the uninstall custom action mirrors with sc.exe stop/delete.
      The PowerShell implementations live in packaging/msi/custom/*.ps1 (see
      the ScriptsDir components above); they are wired up HERE and by
      build_msi.sh, which stages them and passes -define CustomActionScriptsDir.
    -->

    <!--
      The deferred custom actions — the runtime half of this package's trust
      model (verify before execute). Sequencing in the InstallExecuteSequence
      below, in this exact order:

        CheckFoldersCA           BEFORE CreateFolders, on install and repair:
                                 refuses an INSTALLFOLDER anybody but
                                 SYSTEM, Administrators, TrustedInstaller or
                                 an administrator may write (everything
                                 installed there runs as LocalSystem), a
                                 config folder that is a junction or is not
                                 an administrator's, and any folder above
                                 either that a non-administrator could move
                                 (see packaging/msi/custom/folders.ps1);
                                 creates a missing one with its protected
                                 DACL. CreateFolders then applies the config
                                 folder's PermissionEx to a real folder,
                                 never through a junction to another one.
        VerifyBundleCA           AFTER InstallFiles. Runs verify.ps1: the
                                 ADMIN-installed trusted verify_bundle.py with
                                 the admin pubkey (from the trust directory
                                 passed explicitly below as
                                 TRUST_DIR=[ProgramFiles64Folder]udbmcp-trust,
                                 OUTSIDE the bundle; the release public key is
                                 NEVER shipped in this package — the admin
                                 distributes it out-of-band and the action
                                 reads it from machine scope) re-verifies the
                                 installed bundle, and refuses an OLDER
                                 release than the one recorded at
                                 [ProgramFiles64Folder]UniversalDB MCP\manifest.json
                                 unless UDBMCP_ALLOW_DOWNGRADE=1. NO payload may
                                 execute before this action has passed.
        BuildVenvCA              AFTER VerifyBundleCA. venv.ps1 builds the
                                 venv from the verified wheelhouse only
                                 (no-index + require-hashes pip modes,
                                 PIP_CONFIG_FILE neutralized). Still no
                                 payload execution.
        DoctorSmokeCA            AFTER BuildVenvCA. doctor.ps1 — the FIRST
                                 execution of payload code, strictly after
                                 verification passed — validates the install.
        RegisterServiceCA        AFTER DoctorSmokeCA. service.ps1 registers
                                 the udbmcp service via sc.exe (auto start,
                                 failure recovery): sc.exe create, or, for a
                                 service already registered (a repair),
                                 sc.exe config in place. Only verified,
                                 doctor-healthy payload is ever registered as
                                 a service. Its last step records the bundle's
                                 manifest.json as the installed release
                                 ([ProgramFiles64Folder]UniversalDB MCP\manifest.json,
                                 which no INSTALLFOLDER moves; not an MSI
                                 file, so a major upgrade keeps it for the
                                 next VerifyBundleCA).
        RollbackRemoveServiceCA  rollback twin BEFORE RegisterServiceCA: a
                                 rollback action must ALWAYS precede the
                                 deferred action it rolls back in the
                                 sequence, otherwise a failure or user
                                 cancellation during the register action
                                 itself never enters the rollback script and
                                 the half-created service would survive the
                                 rolled-back install. sc.exe state is not
                                 transactional, so the rollback script runs
                                 uninstall.ps1 to stop and delete it (on a
                                 first install or an upgrade; a repair,
                                 -Repair "[Installed]", keeps the service:
                                 one was registered before the repair
                                 began, RegisterServiceCA updates it in
                                 place and never deletes it, and it runs
                                 the restored files),
                                 and to
                                 put back the installed-release record
                                 RegisterServiceCA replaced (from the copy
                                 it kept at manifest.json.previous), so a
                                 rolled-back upgrade does not leave the
                                 newer release recorded; a record this
                                 install did not replace (the marker
                                 manifest.json.kept still there) is left
                                 as it is. The
                                 verify / venv / doctor actions need no
                                 rollback twin: they make no machine-global
                                 change — the MSI transaction itself rolls
                                 back their installed files, and venv.ps1
                                 rebuilds any stale venv from the verified
                                 wheelhouse on the next install attempt
                                 (a token doctor.ps1 removed was one
                                 RegisterServiceCA would have replaced).
        CommitReleaseRecordCA    commit action AFTER RegisterServiceCA: runs
                                 only once the whole install has succeeded
                                 and removes that rollback copy (and the
                                 marker), so no copy outlives its
                                 transaction for a later failed install's
                                 rollback to restore over a newer record.
                                 A copy it cannot remove (a local user can
                                 hold a file under Program Files open)
                                 keeps the marker. Return="ignore": the
                                 install has committed, nothing is left to
                                 roll back, and uninstall.ps1 only warns.
        RemoveServiceCA          BEFORE RemoveFiles, only on uninstall
                                 (REMOVE="ALL"): uninstall.ps1 stops and
                                 deletes the service while its script file
                                 still exists on disk.

      SetPowerShellExe, the immediate action that sets the interpreter all of
      them run (POWERSHELLEXE), comes BEFORE InstallInitialize, without a
      condition: before every deferred action in every mode. An uninstall
      (msiexec /x, or an upgrade's RemoveExistingProducts running the old
      product's sequence) runs RemoveServiceCA at RemoveFiles, long before
      InstallFiles: an interpreter set after InstallFiles left that action
      without one, and every uninstall and upgrade failed (error 1721) and
      rolled back.

      Every action runs Execute="deferred" (or "rollback" for the twin,
      "commit" for the commit action), Impersonate="no" (LocalSystem:
      per-machine writes and sc.exe need it) and Return="check" (the commit
      action: "ignore"): any nonzero exit — verify.ps1 fails closed on EVERY
      verification failure — aborts the install and rolls it back.

      Windows Installer formats the command line of a deferred exe custom
      action when the installation sequence is processed into the execution
      script, so the [INSTALLFOLDER]-style references below resolve at that
      point; nothing is read from the session at execution time.
    -->

    <!--
      powershell.exe lives at a fixed system path on every supported Windows
      host (inbox Windows PowerShell 5.1; System64Folder = System32 in this
      x64 package, so this is the 64-bit interpreter). The path is set by an
      immediate custom action in the execute sequence, before
      InstallInitialize, so every deferred action below sees the resolved
      value at script-generation time, on install, repair and uninstall
      alike — and so a caller-supplied POWERSHELLEXE cannot redirect the
      deferred actions to a different executable (the assignment is
      unconditional).
    -->
    <CustomAction
        Id="SetPowerShellExe"
        Property="POWERSHELLEXE"
        Value="[System64Folder]WindowsPowerShell\v1.0\powershell.exe" />

    <!--
      The folder check (see the sequence notes above). Its script is the
      UTF-8 text of the base64 property UdbmcpFolderCheck, run as a script
      block: nothing in INSTALLFOLDER exists yet, and nothing there may be
      trusted before the check. A formatted string reads [x] as a property,
      so the type names' brackets are spelled [\[] and [\]]; INSTALLFOLDER
      sits between single quotes (a Launch condition refuses one in it), and
      the config folder's path is fixed.
    -->
    <CustomAction
        Id="CheckFoldersCA"
        Property="POWERSHELLEXE"
        ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;&amp; ([\[]scriptblock[\]]::Create([\[]Text.Encoding[\]]::UTF8.GetString([\[]Convert[\]]::FromBase64String('[UdbmcpFolderCheck]')))) -InstallFolder '[INSTALLFOLDER]' -ConfigFolder '[ProgramDataUdbmcpDir]'&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <!--
      TRUST_DIR is passed EXPLICITLY here — never left to verify.ps1's
      fallbacks (a machine-scope UDBMCP_TRUST_DIR, or the default that
      earlier releases put at C:\ProgramData\udbmcp-trust). C:\ProgramData's
      default ACL grants Authenticated Users create-folder/append-data on the
      root and CREATOR OWNER Full Control on directories they create, so a
      NON-ADMIN local process could pre-create (and therefore own) the trust
      directory before the admin bootstrap; the admin's copied verifier would
      then live in attacker-writable space (deletable/replaceable via the
      parent dir's Delete permission) and this action — Impersonate="no",
      i.e. LocalSystem — would execute attacker-controlled Python that can
      exit 0 and print "bundle verification PASSED", defeating the
      verify-before-execute gate entirely. C:\Program Files grants write
      access to administrators only, so a trust directory provisioned there
      cannot be squatted: the exact analogue of the .deb/.pkg bootstrap's
      root-owned `install -d -m 755 /usr/local/lib/udbmcp-trust`
      (packaging/deb, packaging/pkg). The path is deliberately FIXED and
      takes precedence over the machine-scope UDBMCP_TRUST_DIR environment
      override (verify.ps1 reads CustomActionData first): a trust anchor path
      is part of the package's trust model, not a runtime knob. Admins who
      provision elsewhere get a fail-closed diagnostic naming this exact
      path — never a silently weaker gate.
    -->
    <CustomAction
        Id="VerifyBundleCA"
        Property="POWERSHELLEXE"
        ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\verify.ps1&quot; -CustomActionData &quot;BUNDLE_DIR=[INSTALLFOLDER]bundle;TRUST_DIR=[ProgramFiles64Folder]udbmcp-trust;INSTALLED_MANIFEST=[ProgramFiles64Folder]UniversalDB MCP\manifest.json;ALLOW_DOWNGRADE=[UDBMCP_ALLOW_DOWNGRADE]&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <CustomAction
        Id="BuildVenvCA"
        Property="POWERSHELLEXE"
        ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\venv.ps1&quot; -BundleDir &quot;[INSTALLFOLDER]bundle&quot; -VenvDir &quot;[INSTALLFOLDER]venv&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <CustomAction
        Id="DoctorSmokeCA"
        Property="POWERSHELLEXE"
        ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\doctor.ps1&quot; -VenvDir &quot;[INSTALLFOLDER]venv&quot; -ConfigPath &quot;[ProgramDataUdbmcpDir]config.yaml&quot; -BundleManifest &quot;[INSTALLFOLDER]bundle\manifest.json&quot; -ServiceAccount &quot;[UDBMCP_SERVICE_ACCOUNT]&quot; -RegisteredAccount &quot;[UDBMCPREGISTEREDACCOUNT]&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <CustomAction
        Id="RegisterServiceCA"
        Property="POWERSHELLEXE"
        ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\service.ps1&quot; -VenvDir &quot;[INSTALLFOLDER]venv&quot; -ConfigPath &quot;[ProgramDataUdbmcpDir]config.yaml&quot; -ServiceAccount &quot;[UDBMCP_SERVICE_ACCOUNT]&quot; -BundleDir &quot;[INSTALLFOLDER]bundle&quot; -InstalledManifest &quot;[ProgramFiles64Folder]UniversalDB MCP\manifest.json&quot; -RegisteredAccount &quot;[UDBMCPREGISTEREDACCOUNT]&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <CustomAction
        Id="RollbackRemoveServiceCA"
        Property="POWERSHELLEXE"
        ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\uninstall.ps1&quot; -ServiceName &quot;udbmcp&quot; -InstalledManifest &quot;[ProgramFiles64Folder]UniversalDB MCP\manifest.json&quot; -Repair &quot;[Installed]&quot;"
        Execute="rollback"
        Impersonate="no"
        Return="check" />

    <CustomAction
        Id="CommitReleaseRecordCA"
        Property="POWERSHELLEXE"
        ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\uninstall.ps1&quot; -InstalledManifest &quot;[ProgramFiles64Folder]UniversalDB MCP\manifest.json&quot; -Commit"
        Execute="commit"
        Impersonate="no"
        Return="ignore" />

    <CustomAction
        Id="RemoveServiceCA"
        Property="POWERSHELLEXE"
        ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\uninstall.ps1&quot; -ServiceName &quot;udbmcp&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <InstallExecuteSequence>
      <!-- Immediate type-51 assignment, unconditional, before
           InstallInitialize: before every deferred action of an install,
           repair or uninstall, so POWERSHELLEXE is the resolved literal path
           wherever one is written into the script. -->
      <Custom Action="SetPowerShellExe" Before="InstallInitialize" />
      <!-- Install / repair (NOT REMOVE); uninstall skips all of these. -->
      <Custom Action="CheckFoldersCA" Before="CreateFolders" Condition="NOT REMOVE" />
      <Custom Action="VerifyBundleCA" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="BuildVenvCA" After="VerifyBundleCA" Condition="NOT REMOVE" />
      <Custom Action="DoctorSmokeCA" After="BuildVenvCA" Condition="NOT REMOVE" />
      <Custom Action="RegisterServiceCA" After="DoctorSmokeCA" Condition="NOT REMOVE" />
      <Custom Action="RollbackRemoveServiceCA" Before="RegisterServiceCA" Condition="NOT REMOVE" />
      <Custom Action="CommitReleaseRecordCA" After="RegisterServiceCA" Condition="NOT REMOVE" />
      <!-- Uninstall only: remove the service before RemoveFiles deletes the
           uninstall.ps1 file the action itself runs. -->
      <Custom Action="RemoveServiceCA" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="UniversalDB MCP Server" Level="1">
      <!-- Harvested signed-bundle payload: Fragment generated by build_msi.sh
           (built-in WiX v4-native harvester -> harvest.wxi). Fails closed at
           build time if absent. -->
      <ComponentGroupRef Id="HarvestedBundleComponents" />
      <ComponentRef Id="ProgramDataUdbmcpDirAclComponent" />
      <ComponentRef Id="ConfigYamlComponent" />
      <!-- The deferred custom action scripts, shipped inside the MSI. -->
      <ComponentRef Id="VerifyPs1Component" />
      <ComponentRef Id="VenvPs1Component" />
      <ComponentRef Id="DoctorPs1Component" />
      <ComponentRef Id="ServicePs1Component" />
      <ComponentRef Id="UninstallPs1Component" />
    </Feature>
  </Package>

  <!--
    GENERATED AT BUILD TIME by scripts/package/build_msi.sh (built-in
    heat-equivalent WiX v4 fragment generator — heat is not a command of the
    WiX v4+ wix CLI):
      components directly under DirectoryRef Id="BundleDir", one per payload
      file, grouped as ComponentGroup Id="HarvestedBundleComponents", with
      File/@Source resolved via -define BundleSourceDir.
    This include must resolve to a Fragment containing ComponentGroup
    Id="HarvestedBundleComponents". It is intentionally not committed.
  -->
  <?include "harvest.wxi" ?>
</Wix>
