<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Universal Database MCP Server - launchd daemon (macOS).

  This plist mirrors packaging/systemd/universal-db-mcp.service line for line:

    systemd                                   launchd
    ----------------------------------------  --------------------------------------
    [Unit] Description                        (comment above / service description)
    [Service] Type=simple                     (default launchd behavior: on-demand
                                               daemon, no forking)
    [Service] User=udbmcp / Group=udbmcp      UserName _udbmcp (GroupName via
                                               dscl primary group of the account,
                                               set by postinstall)
    [Service] UMask=0077                      Umask 63  (launchd requires decimal:
                                               0077 octal == 63 decimal)
    [Service] Environment=UDBMCP_CONFIG=...   EnvironmentVariables
    [Service] ExecStart=... serve             ProgramArguments
    [Service] Restart=on-failure              KeepAlive { SuccessfulExit = false; }
    [Service] RestartSec=5                    ThrottleInterval 5
    [Service] LimitNOFILE=65536               SoftResourceLimits / HardResourceLimits
                                               NumberOfFiles 65536 (launchd's
                                               default soft limit is 256)
    [Install] WantedBy=multi-user.target      RunAtLoad (start at boot/load),
                                               installed in /Library/LaunchDaemons/
    (implicit low priority service)           ProcessType Background, LowPriorityIO

  HONEST DELTA vs. the systemd unit (documented, not hidden):

  * launchd has NO equivalent of systemd's ProtectSystem=strict /
    ReadWritePaths= sandbox directives (nor NoNewPrivileges,
    ProtectHome, PrivateTmp, ProtectKernelTunables, CapabilityBoundingSet).
    On macOS the following compensating controls apply:
      - Audit-file privacy is enforced by the CODE: the server creates audit
        and metadata-cache files with 0600 permissions (see
        src/universal_db_mcp/services/audit.py), so the Umask 63 here is
        defense-in-depth, not the sole control.
      - State-directory hardening (0750 on /var/lib/universal-db-mcp and
        /var/log/universal-db-mcp, ownership by _udbmcp) is an ADMIN STEP
        performed by postinstall at package install time and documented in
        docs/offline-deployment.md; launchd itself cannot express it.
      - The daemon runs as the dedicated non-privilege service account
        (_udbmcp), which bounds the blast radius of the missing FS sandbox.

  Trust model (unchanged from the signed bundle): this plist only starts the
  already-verified payload under /usr/local/universal-db-mcp/venv/. The venv
  is built by postinstall AFTER the trusted-channel verify_bundle.py run has
  passed against the admin's out-of-band-distributed pubkey. The release
  pubkey is NEVER shipped inside the package.
-->
<plist version="1.0">
<dict>
	<!-- Label MUST equal the installed filename stem
	     (/Library/LaunchDaemons/com.udbmcp.server.plist), the pkg identifier's
	     service label used by packaging/pkg/postinstall (LABEL="com.udbmcp.server",
	     driving launchctl bootout/bootstrap/print), and the admin docs: launchd
	     registers the job under THIS key, not the plist's filename. -->
	<key>Label</key>
	<string>com.udbmcp.server</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/universal-db-mcp/venv/bin/python</string>
		<string>-m</string>
		<string>universal_db_mcp</string>
		<string>serve</string>
		<!-- A daemon under launchd has no client on stdin, so the default
		     config transport (stdio) would read EOF and exit 0 immediately.
		     The system service is the shared authenticated HTTP daemon;
		     per-harness agents keep spawning their own stdio servers. -->
		<string>--transport</string>
		<string>http</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>UDBMCP_CONFIG</key>
		<string>/etc/universal-db-mcp/config.yaml</string>
		<!-- Bearer-token PATH (the token itself stays in the file, created
		     0600 by postinstall). An explicit config value would win; this
		     env fallback keeps the config shareable with stdio spawns. -->
		<key>UDBMCP_HTTP_BEARER_TOKEN_FILE</key>
		<string>/etc/universal-db-mcp/http-token</string>
		<!-- Runtime log of the HTTP listener, size-bounded by the server
		     itself (5 MiB plus 3 backups); the daemon opens it as _udbmcp.
		     Nothing rotates StandardOutPath or StandardErrorPath: a root job
		     acts on whatever names are in their directory. With this set,
		     serve empties either file when it is over 5 MiB, at startup and
		     before an ERROR record, and stderr only gets startup failures
		     and ERROR records (a port in use, an exception), which http.log
		     has too. -->
		<key>UDBMCP_HTTP_LOG_FILE</key>
		<string>/var/log/universal-db-mcp/http.log</string>
	</dict>

	<!-- Mirrors systemd User=udbmcp (macOS service account created by
	     postinstall is named _udbmcp, following the _-prefixed convention). -->
	<key>UserName</key>
	<string>_udbmcp</string>

	<!-- launchd Umask is DECIMAL. systemd UMask=0077 (octal) == 63 decimal.
	     0077 octal = 0*64 + 7*8 + 7 = 63. Keeps group/other bits off for files
	     the server creates (audit trail, metadata cache). -->
	<key>Umask</key>
	<integer>63</integer>

	<!-- Mirrors [Install] WantedBy=multi-user.target: start at boot. -->
	<key>RunAtLoad</key>
	<true/>

	<!-- Mirrors systemd Restart=on-failure: restart only when the process
	     exits non-zero (a clean exit is NOT restarted). -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<!-- Mirrors systemd RestartSec=5. -->
	<key>ThrottleInterval</key>
	<integer>5</integer>

	<key>ProcessType</key>
	<string>Background</string>

	<key>LowPriorityIO</key>
	<true/>

	<!-- Mirrors systemd LimitNOFILE=65536: every connection holds a
	     descriptor, and launchd's default soft limit is 256. -->
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>65536</integer>
	</dict>
	<key>HardResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>65536</integer>
	</dict>

	<!-- launchd opens these itself, as root, before the daemon becomes
	     _udbmcp, creating them and following a symlink there. So they are
	     never in /var/log/universal-db-mcp, which _udbmcp owns (a link it
	     put at server.log would lead root's open to any file), but in
	     /Library/Logs/universal-db-mcp, which only root can write; the
	     postinstall creates it and makes both files _udbmcp's, so the
	     daemon can cap them (it empties only a file it owns). -->
	<key>StandardOutPath</key>
	<string>/Library/Logs/universal-db-mcp/server.log</string>

	<key>StandardErrorPath</key>
	<string>/Library/Logs/universal-db-mcp/server.err.log</string>
</dict>
</plist>
