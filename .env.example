# Example environment for universal-db-mcp (copy and fill in per deployment).
# Values here are placeholders supplied by the organization's operator.

# Configuration path referenced by the Claude Code .mcp.json example:
UDBMCP_CONFIG=/etc/universal-db-mcp/config.yaml

# Per-connection credential environment variables (see username_env /
# password_env in config.yaml). Prefer password_file over env vars where
# possible; secret files must not be group/world readable.
# FINANCE_DB2_USER=udbmcp_ro
# ANALYTICS_PG_USER=udbmcp_ro
